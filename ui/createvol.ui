<?xml version='1.0' encoding='UTF-8'?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <object class="GtkAdjustment" id="adjustment1">
    <property name="upper">100000</property>
    <property name="value">1</property>
    <property name="step-increment">1</property>
    <property name="page-increment">1000</property>
  </object>
  <object class="GtkAdjustment" id="adjustment2">
    <property name="upper">100000</property>
    <property name="value">1</property>
    <property name="step-increment">1</property>
    <property name="page-increment">1000</property>
  </object>
  <object class="GtkImage" id="image1">
    <property name="icon-name">document-new</property>
  </object>
  <object class="GtkWindow" id="vmm-create-vol">
    <property name="title" translatable="1">Add a Storage Volume</property>
    <signal name="close-request" handler="on_vmm_create_vol_delete_event" swapped="no"/>
    <property name="child">
      <object class="GtkBox" id="box1">
        <property name="orientation">vertical</property>
        <property name="spacing">6</property>
        <child>
          <object class="GtkViewport" id="header">
            <property name="child">
              <object class="GtkBox" id="hbox77">
                <property name="spacing">10</property>
                <child>
                  <object class="GtkImage" id="image4">
                    <property name="halign">center</property>
                    <property name="icon-name">document-new</property>
                    <property name="pixel-size">48</property>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="hbox2">
                    <property name="hexpand">1</property>
                    <child>
                      <object class="GtkLabel" id="label1">
                        <property name="hexpand">1</property>
                        <property name="halign">start</property>
                        <property name="label" translatable="1">&lt;span size='large'&gt;Create storage volume&lt;/span&gt;</property>
                        <property name="use-markup">1</property>
                        <style>
                          <class name="vmm-header-text"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
              <property name="margin-start">6</property><property name="margin-end">6</property><property name="margin-top">6</property><property name="margin-bottom">6</property></object>
            </property>
            <style>
              <class name="vmm-header"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="vbox1">
            <property name="vexpand">1</property>
            <property name="orientation">vertical</property>
            <property name="spacing">18</property>
            <child>
              <object class="GtkBox" id="details-box-align">
                <property name="vexpand">1</property>
                <property name="width-request">400</property>
                <property name="height-request">400</property>
                <child>
                  <object class="GtkBox" id="details-box">
                    <property name="orientation">vertical</property>
                    <property name="spacing">12</property>
                    <child>
                      <object class="GtkLabel" id="label3">
                        <property name="halign">start</property>
                        <property name="label" translatable="1">Create a storage unit to be used directly by a virtual machine.</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkGrid" id="vbox4">
                        <property name="vexpand">1</property>
                        <property name="row-spacing">18</property>
                        <child>
                          <object class="GtkGrid" id="table1">
                            <property name="hexpand">1</property>
                            <property name="row-spacing">6</property>
                            <property name="column-spacing">6</property>
                            <child>
                              <object class="GtkBox" id="hbox10">
                                <property name="spacing">2</property>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">0</property>
                                </layout>
                                <child>
                                  <object class="GtkEntry" id="vol-name">
                                    <property name="hexpand">1</property>
                                    <property name="focusable">1</property>
                                    <property name="invisible-char">●</property>
                                    <property name="width-chars">30</property>
                                    <signal name="changed" handler="on_vol_name_changed" swapped="no"/>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="vol-name-suffix">
                                    <property name="halign">center</property>
                                    <property name="label">suffix</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="label4">
                                <property name="halign">start</property>
                                <property name="label" translatable="1">_Name:</property>
                                <property name="use-underline">1</property>
                                <property name="mnemonic-widget">vol-name</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">0</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="label5">
                                <property name="halign">start</property>
                                <property name="label" translatable="1">F_ormat:</property>
                                <property name="use-underline">1</property>
                                <property name="mnemonic-widget">vol-format</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">1</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkComboBox" id="vol-format">
                                <property name="halign">start</property>
                                <property name="has-entry">1</property>
                                <signal name="changed" handler="on_vol_format_changed" swapped="no"/>
                                <child internal-child="entry">
                                  <object class="GtkEntry" id="vol-format-entry">
                                    <property name="focusable">1</property>
                                    <property name="width-chars">10</property>
                                  </object>
                                </child>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">1</property>
                                </layout>
                              </object>
                            </child>
                            <layout>
                              <property name="column">0</property>
                              <property name="row">0</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox" id="size-box">
                            <property name="orientation">vertical</property>
                            <property name="spacing">5</property>
                            <layout>
                              <property name="column">0</property>
                              <property name="row">2</property>
                            </layout>
                            <child>
                              <object class="GtkBox" id="vbox6">
                                <property name="valign">center</property>
                                <property name="orientation">vertical</property>
                                <child>
                                  <object class="GtkLabel" id="label10">
                                    <property name="valign">center</property>
                                    <property name="halign">start</property>
                                    <property name="label" translatable="1">&lt;b&gt;Storage Volume Quota&lt;/b&gt;</property>
                                    <property name="use-markup">1</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="vol-parent-info">
                                    <property name="halign">start</property>
                                    <property name="label">&lt;b&gt;pool's&lt;/b&gt; available space: X GiB</property>
                                    <property name="use-markup">1</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkGrid" id="table2">
                                <property name="valign">center</property>
                                <property name="halign">start</property>
                                <property name="row-spacing">6</property>
                                <property name="column-spacing">6</property>
                                <child>
                                  <object class="GtkSpinButton" id="vol-capacity">
                                    <property name="focusable">1</property>
                                    <property name="text" translatable="1">1.0</property>
                                    <property name="adjustment">adjustment2</property>
                                    <property name="climb-rate">10</property>
                                    <property name="digits">1</property>
                                    <property name="value">1</property>
                                    <layout>
                                      <property name="column">1</property>
                                      <property name="row">0</property>
                                    </layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="label8">
                                    <property name="halign">start</property>
                                    <property name="label" translatable="1">GiB</property>
                                    <layout>
                                      <property name="column">2</property>
                                      <property name="row">0</property>
                                    </layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="label6">
                                    <property name="halign">end</property>
                                    <property name="label" translatable="1">Ca_pacity:</property>
                                    <property name="use-underline">1</property>
                                    <property name="mnemonic-widget">vol-capacity</property>
                                    <layout>
                                      <property name="column">0</property>
                                      <property name="row">0</property>
                                    </layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkCheckButton" id="vol-nonsparse">
                                    <property name="label" translatable="1">_Allocate entire volume now</property>
                                    <property name="focusable">1</property>
                                    <property name="use-underline">1</property>
                                    <layout>
                                      <property name="column">1</property>
                                      <property name="row">1</property>
                                      <property name="column-span">2</property>
                                    </layout>
                                  </object>
                                </child>
                                <child>
                                  <placeholder/>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkExpander" id="backing-expander">
                            <property name="focusable">1</property>
                            <property name="vexpand">0</property>
                            <property name="expanded">1</property>
                            <child>
                              <object class="GtkGrid" id="grid1">
                                <property name="margin-top">4</property>
                                <property name="column-spacing">6</property>
                                <child>
                                  <object class="GtkLabel" id="label11">
                                    <property name="label" translatable="1">Pa_th:</property>
                                    <property name="use-underline">1</property>
                                    <property name="mnemonic-widget">backing-store</property>
                                    <layout>
                                      <property name="column">0</property>
                                      <property name="row">0</property>
                                    </layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkEntry" id="backing-store">
                                    <property name="focusable">1</property>
                                    <property name="hexpand">1</property>
                                    <layout>
                                      <property name="column">1</property>
                                      <property name="row">0</property>
                                    </layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkButton" id="backing-browse">
                                    <property name="label" translatable="1">_Browse...</property>
                                    <property name="focusable">1</property>
                                    <property name="receives-default">1</property>
                                    <property name="use-underline">1</property>
                                    <signal name="clicked" handler="on_backing_browse_clicked" swapped="no"/>
                                    <layout>
                                      <property name="column">2</property>
                                      <property name="row">0</property>
                                    </layout>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child type="label">
                              <object class="GtkLabel" id="label2">
                                <property name="hexpand">0</property>
                                <property name="label" translatable="1">_Backing store</property>
                                <property name="use-underline">1</property>
                              </object>
                            </child>
                            <layout>
                              <property name="column">0</property>
                              <property name="row">1</property>
                            </layout>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="hbuttonbox1">
                <property name="visible">True</property>
                <property name="spacing">6</property>
                <child>
                  <object class="GtkButton" id="vol-cancel">
                    <property name="label" translatable="1">_Cancel</property>
                    <property name="focusable">1</property>
                    <property name="receives-default">1</property>
                    <property name="use-underline">1</property>
                    <signal name="clicked" handler="on_vol_cancel_clicked" swapped="no"/>
                  </object>
                  </child>
                <child>
                  <object class="GtkButton" id="vol-create">
                    <property name="label" translatable="1">_Finish</property>
                    <property name="focusable">1</property>
                    <property name="receives-default">1</property>
                    <property name="use-underline">1</property>
                    <signal name="clicked" handler="on_vol_create_clicked" swapped="no"/>
                  </object>
                  </child>
              </object>
            </child>
          <property name="margin-start">12</property><property name="margin-end">12</property><property name="margin-top">12</property><property name="margin-bottom">12</property></object>
        </child>
      </object>
    </property>
  </object>
</interface>
