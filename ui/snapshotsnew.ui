<?xml version='1.0' encoding='UTF-8'?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <object class="GtkWindow" id="snapshot-new">
    <property name="title" translatable="1">Create snapshot</property>
    <signal name="close-request" handler="on_snapshot_new_delete_event" swapped="no"/>
    <property name="child">
      <object class="GtkBox" id="box1">
        <property name="orientation">vertical</property>
        <property name="spacing">6</property>
        <child>
          <object class="GtkViewport" id="header">
            <property name="child">
              <object class="GtkBox" id="hbox77">
                <property name="spacing">10</property>
                <child>
                  <object class="GtkImage" id="image4">
                    <property name="halign">center</property>
                    <property name="icon-name">document-new</property>
                    <property name="pixel-size">48</property>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="hbox2">
                    <property name="hexpand">1</property>
                    <child>
                      <object class="GtkLabel" id="label2">
                        <property name="hexpand">1</property>
                        <property name="halign">start</property>
                        <property name="label" translatable="1">&lt;span size='large'&gt;Create snapshot&lt;/span&gt;</property>
                        <property name="use-markup">1</property>
                        <style>
                          <class name="vmm-header-text"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
              <property name="margin-start">6</property><property name="margin-end">6</property><property name="margin-top">6</property><property name="margin-bottom">6</property></object>
            </property>
            <style>
              <class name="vmm-header"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="box3">
            <property name="vexpand">1</property>
            <property name="orientation">vertical</property>
            <property name="spacing">18</property>
            <child>
              <object class="GtkBox" id="snapshot-new-box-align">
                <property name="vexpand">1</property>
                <child>
                  <object class="GtkGrid" id="snapshot-new-box">
                    <property name="row-spacing">6</property>
                    <property name="column-spacing">6</property>
                    <child>
                      <object class="GtkLabel" id="label1">
                        <property name="halign">start</property>
                        <property name="label" translatable="1">_Name:</property>
                        <property name="use-underline">1</property>
                        <property name="mnemonic-widget">snapshot-new-name</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">0</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="snapshot-new-name">
                        <property name="focusable">1</property>
                        <property name="invisible-char">●</property>
                        <signal name="activate" handler="on_snapshot_new_name_activate" swapped="no"/>
                        <signal name="changed" handler="on_snapshot_new_name_changed" swapped="no"/>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">0</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="label3">
                        <property name="halign">start</property>
                        <property name="valign">start</property>
                        <property name="label" translatable="1">_Description:</property>
                        <property name="use-underline">1</property>
                        <property name="mnemonic-widget">snapshot-new-description</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">4</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkScrolledWindow" id="scrolledwindow1">
                        <property name="width-request">300</property>
                        <property name="height-request">125</property>
                        <property name="focusable">1</property>
                        <property name="child">
                          <object class="GtkTextView" id="snapshot-new-description">
                            <property name="focusable">1</property>
                          </object>
                        </property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">4</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="label4">
                        <property name="halign">start</property>
                        <property name="label" translatable="1">Status:</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">1</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox" id="hbox1">
                        <property name="spacing">3</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">1</property>
                        </layout>
                        <child>
                          <object class="GtkImage" id="snapshot-new-status-icon"/>
                        </child>
                        <child>
                          <object class="GtkLabel" id="snapshot-new-status-text">
                            <property name="halign">start</property>
                            <property name="label">Shut down</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="snapshot-new-mode-label">
                        <property name="halign">start</property>
                        <property name="label" translatable="1">Snapshot _Mode:</property>
                        <property name="use-underline">1</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">2</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox" id="snapshot-new-mode-box">
                        <property name="visible">True</property>
                        <child>
                          <object class="GtkCheckButton" id="snapshot-new-mode-external">
                            <property name="label" translatable="1">_external</property>
                            <property name="focusable">1</property>
                            <property name="use-underline">1</property>
                            <property name="active">1</property>
                            <signal name="toggled" handler="on_snapshot_new_mode_toggled" swapped="no"/>
                          <property name="hexpand">1</property></object>
                          </child>
                        <child>
                          <object class="GtkCheckButton" id="snapshot-new-mode-internal">
                            <property name="label" translatable="1">_internal</property>
                            <property name="focusable">1</property>
                            <property name="use-underline">1</property>
                            <property name="group">snapshot-new-mode-external</property>
                          <property name="hexpand">1</property></object>
                          </child>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">2</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="snapshot-new-memory-label">
                        <property name="halign">start</property>
                        <property name="label" translatable="1">Memory _State:</property>
                        <property name="use-underline">1</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">3</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox" id="snapshot-new-memory-box">
                        <layout>
                          <property name="column">1</property>
                          <property name="row">3</property>
                        </layout>
                        <child>
                          <object class="GtkCheckButton" id="snapshot-new-memory-auto">
                            <property name="label" translatable="1">_auto</property>
                            <property name="focusable">1</property>
                            <property name="use-underline">1</property>
                            <signal name="toggled" handler="on_snapshot_new_memory_toggled" swapped="no"/>
                          </object>
                        </child>
                        <child>
                          <object class="GtkComboBox" id="snapshot-new-memory-path">
                            <property name="hexpand">1</property>
                            <property name="has-entry">1</property>
                            <child internal-child="entry">
                              <object class="GtkEntry">
                                <property name="focusable">1</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="buttonbox2">
                <property name="visible">True</property>
                <property name="spacing">6</property>
                <child>
                  <object class="GtkButton" id="snapshot-new-cancel">
                    <property name="label" translatable="1">_Cancel</property>
                    <property name="focusable">1</property>
                    <property name="receives-default">1</property>
                    <property name="use-underline">1</property>
                    <signal name="clicked" handler="on_snapshot_new_cancel_clicked" swapped="no"/>
                  </object>
                  </child>
                <child>
                  <object class="GtkButton" id="snapshot-new-ok">
                    <property name="label" translatable="1">_Finish</property>
                    <property name="focusable">1</property>
                    <property name="receives-default">1</property>
                    <property name="use-underline">1</property>
                    <signal name="clicked" handler="on_snapshot_new_ok_clicked" swapped="no"/>
                  </object>
                  </child>
              </object>
            </child>
          <property name="margin-start">12</property><property name="margin-end">12</property><property name="margin-top">12</property><property name="margin-bottom">12</property></object>
        </child>
      </object>
    </property>
  </object>
</interface>
