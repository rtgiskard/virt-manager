<?xml version='1.0' encoding='UTF-8'?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <object class="GtkGrid" id="storage-grid">
    <child>
      <object class="GtkBox" id="hbox9">
        <property name="valign">end</property>
        <layout>
          <property name="column">0</property>
          <property name="row">1</property>
        </layout>
        <child>
          <object class="GtkBox" id="hbox10">
            <property name="hexpand">1</property>
            <child>
              <object class="GtkButton" id="pool-add">
                <property name="halign">center</property>
                <property name="focusable">1</property>
                <property name="tooltip-text" translatable="1">Add Pool</property>
                <signal name="clicked" handler="on_pool_add_clicked" swapped="no"/>
                <child>
                  <object class="GtkImage" id="image4">
                    <property name="icon-name">list-add</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="pool-start">
                <property name="halign">center</property>
                <property name="focusable">1</property>
                <property name="tooltip-text" translatable="1">Start Pool</property>
                <signal name="clicked" handler="on_pool_start_clicked" swapped="no"/>
                <child>
                  <object class="GtkImage" id="someicon">
                    <property name="icon-name">media-playback-start</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="pool-stop">
                <property name="halign">center</property>
                <property name="focusable">1</property>
                <property name="tooltip-text" translatable="1">Stop Pool</property>
                <signal name="clicked" handler="on_pool_stop_clicked" swapped="no"/>
                <child>
                  <object class="GtkImage" id="image6">
                    <property name="icon-name">process-stop</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="pool-delete">
                <property name="halign">center</property>
                <property name="focusable">1</property>
                <property name="tooltip-text" translatable="1">Delete Pool</property>
                <signal name="clicked" handler="on_pool_delete_clicked" swapped="no"/>
                <child>
                  <object class="GtkImage" id="image7">
                    <property name="icon-name">edit-delete</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="hbox11">
            <property name="spacing">6</property>
            <child>
              <object class="GtkButton" id="browse-local">
                <property name="halign">center</property>
                <property name="label" translatable="1">_Browse Local</property>
                <property name="focusable">1</property>
                <property name="receives-default">1</property>
                <property name="tooltip-text" translatable="1">Browse local filesystem</property>
                <property name="use-underline">1</property>
                <signal name="clicked" handler="on_browse_local_clicked" swapped="no"/>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="browse-cancel">
                <property name="hexpand">1</property>
                <property name="label" translatable="1">_Cancel</property>
                <property name="focusable">1</property>
                <property name="receives-default">1</property>
                <property name="tooltip-text" translatable="1">Cancel and close dialog</property>
                <property name="use-underline">1</property>
                <signal name="clicked" handler="on_browse_cancel_clicked" swapped="no"/>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="choose-volume">
                <property name="hexpand">1</property>
                <property name="label" translatable="1">Ch_oose Volume</property>
                <property name="focusable">1</property>
                <property name="receives-default">1</property>
                <property name="tooltip-text" translatable="1">Choose the selected volume</property>
                <property name="use-underline">1</property>
                <signal name="clicked" handler="on_choose_volume_clicked" swapped="no"/>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="pool-apply">
                <property name="halign">center</property>
                <property name="label" translatable="1">_Apply</property>
                <property name="focusable">1</property>
                <property name="tooltip-text" translatable="1">Apply pool changes</property>
                <property name="use-underline">1</property>
                <signal name="clicked" handler="on_pool_apply_clicked" swapped="no"/>
              </object>
            </child>
          </object>
        </child>
        <property name="margin-start">3</property>
        <property name="margin-end">3</property>
        <property name="margin-top">3</property>
        <property name="margin-bottom">3</property>
      </object>
    </child>
    <child>
      <object class="GtkPaned" id="storage-pane">
        <property name="resize-start-child">0</property>
        <property name="focusable">1</property>
        <property name="hexpand">1</property>
        <property name="vexpand">1</property>
        <property name="position">200</property>
        <property name="start-child">
          <object class="GtkScrolledWindow" id="pool-scroll">
            <property name="focusable">1</property>
            <property name="hscrollbar-policy">never</property>
            <property name="child">
              <object class="GtkTreeView" id="pool-list">
                <property name="width-request">134</property>
                <property name="focusable">1</property>
                <property name="headers-visible">0</property>
                <child internal-child="selection">
                  <object class="GtkTreeSelection" id="treeview-selection"/>
                </child>
              </object>
            </property>
          </object>
        </property>
        <property name="end-child">
          <object class="GtkNotebook" id="storage-pages">
            <property name="focusable">1</property>
            <property name="show-border">0</property>
            <child>
              <object class="GtkNotebookPage">
                <property name="child">
                  <object class="GtkBox" id="pool-details-align">
                    <child>
                      <object class="GtkBox" id="pool-details">
                        <property name="orientation">vertical</property>
                        <property name="spacing">6</property>
                        <child>
                          <object class="GtkGrid" id="table5">
                            <property name="row-spacing">5</property>
                            <property name="column-spacing">8</property>
                            <child>
                              <object class="GtkBox" id="pool-state-box">
                                <property name="spacing">3</property>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">3</property>
                                </layout>
                                <child>
                                  <object class="GtkImage" id="pool-state-icon">
                                    <property name="halign">start</property>
                                    <property name="icon-name">image-missing</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="pool-state">
                                    <property name="halign">center</property>
                                    <property name="label" translatable="1">Active</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkCheckButton" id="pool-autostart">
                                <property name="label">Some label</property>
                                <property name="focusable">1</property>
                                <property name="halign">start</property>
                                <property name="use-underline">1</property>
                                <signal name="toggled" handler="on_pool_autostart_toggled" swapped="no"/>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">4</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="pool-location">
                                <property name="halign">start</property>
                                <property name="label">label</property>
                                <property name="selectable">1</property>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">2</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkEntry" id="pool-name-entry">
                                <property name="focusable">1</property>
                                <signal name="changed" handler="on_pool_name_changed" swapped="no"/>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">0</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="label11">
                                <property name="halign">start</property>
                                <property name="label" translatable="1">Name:</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">0</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="label60">
                                <property name="halign">start</property>
                                <property name="label" translatable="1">Location:</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">2</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="label173">
                                <property name="halign">start</property>
                                <property name="label" translatable="1">State:</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">3</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="label76">
                                <property name="halign">start</property>
                                <property name="label" translatable="1">A_utostart:</property>
                                <property name="use-underline">1</property>
                                <property name="mnemonic-widget">pool-autostart</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">4</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="label1">
                                <property name="halign">start</property>
                                <property name="label" translatable="1">Size:</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">1</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="pool-sizes">
                                <property name="halign">start</property>
                                <property name="label" translatable="1">label</property>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">1</property>
                                </layout>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox" id="vbox6">
                            <property name="vexpand">1</property>
                            <property name="orientation">vertical</property>
                            <property name="spacing">3</property>
                            <child>
                              <object class="GtkBox" id="hbox12">
                                <property name="valign">center</property>
                                <property name="spacing">6</property>
                                <child>
                                  <object class="GtkLabel" id="label77">
                                    <property name="halign">center</property>
                                    <property name="label" translatable="1">&lt;b&gt;Volumes&lt;/b&gt;</property>
                                    <property name="use-markup">1</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkBox" id="box1">
                                    <property name="hexpand">1</property>
                                    <child>
                                      <object class="GtkButton" id="vol-add">
                                        <property name="halign">center</property>
                                        <property name="focusable">1</property>
                                        <property name="use-underline">1</property>
                                        <signal name="clicked" handler="on_vol_add_clicked" swapped="no"/>
                                        <child>
                                          <object class="GtkImage" id="image1">
                                            <property name="icon-name">list-add</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkButton" id="pool-refresh">
                                        <property name="focusable">1</property>
                                        <property name="receives-default">1</property>
                                        <property name="has-tooltip">1</property>
                                        <property name="tooltip-text" translatable="1">Refresh volume list</property>
                                        <signal name="clicked" handler="on_pool_refresh_clicked" swapped="no"/>
                                        <child>
                                          <object class="GtkImage" id="image8">
                                            <property name="icon-name">view-refresh</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkButton" id="vol-delete">
                                        <property name="halign">center</property>
                                        <property name="focusable">1</property>
                                        <property name="tooltip-text" translatable="1">Delete volume</property>
                                        <property name="use-underline">1</property>
                                        <signal name="clicked" handler="on_vol_delete_clicked" swapped="no"/>
                                        <child>
                                          <object class="GtkImage" id="image2">
                                            <property name="icon-name">edit-delete</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkScrolledWindow" id="vol-scroll">
                                <property name="focusable">1</property>
                                <property name="vexpand">1</property>
                                <property name="child">
                                  <object class="GtkTreeView" id="vol-list">
                                    <property name="focusable">1</property>
                                    <signal name="row-activated" handler="on_vol_list_row_activated" swapped="no"/>
                                    <child internal-child="selection">
                                      <object class="GtkTreeSelection" id="treeview-selection1">
                                        <signal name="changed" handler="on_vol_list_changed" swapped="no"/>
                                      </object>
                                    </child>
                                  </object>
                                </property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </property>
                <property name="tab">
                  <object class="GtkLabel" id="label123">
                    <property name="label">info</property>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkNotebookPage">
                <property name="position">1</property>
                <property name="child">
                  <object class="GtkLabel" id="storage-error-label">
                    <property name="label">some error here</property>
                  </object>
                </property>
                <property name="tab">
                  <object class="GtkLabel" id="label24">
                    <property name="label">error</property>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </property>
        <layout>
          <property name="column">0</property>
          <property name="row">0</property>
        </layout>
        <property name="margin-start">3</property>
        <property name="margin-end">3</property>
        <property name="margin-top">3</property>
        <property name="margin-bottom">3</property>
      </object>
    </child>
    <property name="margin-start">3</property>
    <property name="margin-end">3</property>
    <property name="margin-top">3</property>
    <property name="margin-bottom">3</property>
  </object>
</interface>
