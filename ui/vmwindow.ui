<?xml version='1.0' encoding='UTF-8'?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <object class="GtkWindow" id="vmm-vmwindow">
    <property name="title" translatable="1">Virtual Machine</property>
    <property name="default-width">900</property>
    <property name="default-height">640</property>
    <signal name="close-request" handler="on_vmm_details_delete_event" swapped="no"/>
    <property name="child">
      <object class="GtkBox" id="vbox2">
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkBox" id="details-menubar">
            <property name="valign">center</property>
            <property name="visible">True</property>
            <style>
              <class name="vmm-menubar"/>
            </style>
            <child>
              <object class="GtkMenuButton" id="file1">
                <property name="visible">True</property>
                <property name="has-frame">False</property>
                <property name="direction">none</property>
                <property name="label" translatable="1">_File</property>
                <property name="use-underline">True</property>
                <property name="popover"><object class="GtkPopover" id="file1_menu">
                    <property name="child"><object class="GtkBox" id="file1_menu-items"><property name="orientation">vertical</property><child>
                          <object class="VmmMenuActionButton" id="view_manager">
                        <property name="visible">True</property>
                        <property name="label" translatable="1">_View Manager</property>
                        <property name="use-underline">True</property>
                        <signal name="clicked" handler="on_details_menu_view_manager_activate" swapped="no"/>
                      </object>
                    </child>
                    <child>
                      <object class="GtkSeparator" id="separator15">
                        <property name="visible">True</property>
                      </object>
                    </child>
                    <child>
                          <object class="VmmMenuActionButton" id="close4">
                        <property name="visible">True</property>
                        <property name="label" translatable="1">_Close</property>
                        <property name="use-underline">True</property>
                        <signal name="clicked" handler="on_details_menu_close_activate" swapped="no"/>
                        </object>
                    </child>
                    <child>
                          <object class="VmmMenuActionButton" id="quit3">
                        <property name="visible">True</property>
                        <property name="label" translatable="1">_Quit</property>
                        <property name="use-underline">True</property>
                        <signal name="clicked" handler="on_details_menu_quit_activate" swapped="no"/>
                        </object>
                    </child>
                  </object></property></object>
                </property></object>
            </child>
            <child>
              <object class="GtkMenuButton" id="details-vm-menu">
                <property name="visible">True</property>
                <property name="has-frame">False</property>
                <property name="direction">none</property>
                <property name="label" translatable="1">Virtual _Machine</property>
                <property name="use-underline">True</property>
                <property name="popover"><object class="GtkPopover" id="virtual_machine1_menu">
                    <signal name="show" handler="on_details_menu_virtual_manager_activate" swapped="no"/>
                    <property name="child"><object class="GtkBox" id="virtual_machine1_menu-items"><property name="orientation">vertical</property><child>
                      <object class="GtkSeparator" id="separator2">
                        <property name="visible">True</property>
                      </object>
                    </child>
                    <child>
                          <object class="VmmMenuActionButton" id="details-menu-vm-screenshot">
                        <property name="visible">True</property>
                        <property name="label" translatable="1">_Take Screenshot</property>
                        <property name="use-underline">True</property>
                        <signal name="clicked" handler="on_details_menu_screenshot_activate" swapped="no"/>
                      </object>
                    </child>
                    <child>
                          <object class="VmmMenuActionButton" id="details-menu-usb-redirection">
                        <property name="visible">True</property>
                        <property name="tooltip-text" translatable="1">Redirect host USB device to virtual machine with SPICE graphics.</property>
                        <property name="label" translatable="1">_Redirect USB device</property>
                        <property name="use-underline">True</property>
                        <signal name="clicked" handler="on_details_menu_usb_redirection" swapped="no"/>
                      </object>
                    </child>
                  </object></property></object>
                </property></object>
            </child>
            <child>
              <object class="GtkMenuButton" id="view2">
                <property name="visible">True</property>
                <property name="has-frame">False</property>
                <property name="direction">none</property>
                <property name="label" translatable="1">_View</property>
                <property name="use-underline">True</property>
                <property name="popover"><object class="GtkPopover" id="view2_menu">
                    <property name="child"><object class="GtkBox" id="view2_menu-items"><property name="orientation">vertical</property><child>
                      <object class="GtkCheckButton" id="details-menu-view-console">
                        <property name="visible">True</property>
                        <property name="label" translatable="1">_Console</property>
                        <property name="use-underline">True</property>
                        <property name="active">True</property>
                        <signal name="toggled" handler="on_details_menu_view_console_toggled" swapped="no"/>
                      </object>
                    </child>
                    <child>
                      <object class="GtkCheckButton" id="details-menu-view-details">
                        <property name="visible">True</property>
                        <property name="label" translatable="1">_Details</property>
                        <property name="use-underline">True</property>
                        <property name="group">details-menu-view-console</property>
                        <signal name="toggled" handler="on_details_menu_view_details_toggled" swapped="no"/>
                      </object>
                    </child>
                    <child>
                      <object class="GtkCheckButton" id="details-menu-view-snapshots">
                        <property name="visible">True</property>
                        <property name="label" translatable="1">Sna_pshots</property>
                        <property name="use-underline">True</property>
                        <property name="group">details-menu-view-console</property>
                        <signal name="toggled" handler="on_details_menu_view_snapshots_toggled" swapped="no"/>
                      </object>
                    </child>
                    <child>
                      <object class="GtkSeparator" id="menuitem2">
                        <property name="visible">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkCheckButton" id="details-menu-view-fullscreen">
                        <property name="visible">True</property>
                        <property name="label" translatable="1">_Fullscreen</property>
                        <property name="use-underline">True</property>
                        <signal name="toggled" handler="on_details_menu_view_fullscreen_activate" swapped="no"/>
                      </object>
                    </child>
                    <child>
                          <object class="VmmMenuActionButton" id="detains-menu-view-size-to-vm">
                        <property name="visible">True</property>
                        <property name="label" translatable="1">_Resize to VM</property>
                        <property name="use-underline">True</property>
                        <signal name="clicked" handler="on_details_menu_view_size_to_vm_activate" swapped="no"/>
                      </object>
                    </child>
                    <child>
                          <object class="GtkMenuButton" id="menuitem1">
                        <property name="visible">True</property>
                        <property name="label" translatable="1">_Scale Display</property>
                        <property name="use-underline">True</property>
                            <property name="popover">
                              <object class="GtkPopover" id="view-scale-menu">
                        <property name="child"><object class="GtkBox" id="menu1"><property name="orientation">vertical</property><child>
                              <object class="GtkCheckButton" id="details-menu-view-scale-always">
                                <property name="visible">True</property>
                                <property name="label" translatable="1">_Always</property>
                                <property name="use-underline">True</property>
                                <property name="active">True</property>
                                <signal name="toggled" handler="on_details_menu_view_scale_always_toggled" swapped="no"/>
                              </object>
                            </child>
                            <child>
                              <object class="GtkCheckButton" id="details-menu-view-scale-fullscreen">
                                <property name="visible">True</property>
                                <property name="label" translatable="1">_Only when Fullscreen</property>
                                <property name="use-underline">True</property>
                                <property name="group">details-menu-view-scale-always</property>
                                <signal name="toggled" handler="on_details_menu_view_scale_fullscreen_toggled" swapped="no"/>
                              </object>
                            </child>
                            <child>
                              <object class="GtkCheckButton" id="details-menu-view-scale-never">
                                <property name="visible">True</property>
                                <property name="label" translatable="1">_Never</property>
                                <property name="use-underline">True</property>
                                <property name="group">details-menu-view-scale-always</property>
                                <signal name="toggled" handler="on_details_menu_view_scale_never_toggled" swapped="no"/>
                              </object>
                            </child>
                            <child>
                              <object class="GtkSeparator" id="menuitem3">
                                <property name="visible">True</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkCheckButton" id="details-menu-view-resizeguest">
                                <property name="visible">True</property>
                                <property name="label" translatable="1">Auto _resize VM with window</property>
                                <property name="use-underline">True</property>
                                <signal name="toggled" handler="on_details_menu_view_resizeguest_toggled" swapped="no"/>
                              </object>
                            </child>
                          </object></property></object>
                            </property>
                          </object>
                    </child>
                    <child>
                      <object class="GtkMenuButton" id="details-menu-view-console-list">
                        <property name="visible">True</property>
                        <property name="label" translatable="1">Co_nsoles</property>
                        <property name="use-underline">True</property>
                      <property name="popover"><object class="GtkPopover" id="details-menu-view-console-list-popover"><property name="child"><object class="GtkBox" id="details-menu-view-console-list-popover-items"><property name="orientation">vertical</property></object></property></object></property></object>
                    </child>
                    <child>
                      <object class="GtkCheckButton" id="details-menu-view-autoconnect">
                        <property name="visible">True</property>
                        <property name="label" translatable="1">_Autoconnect</property>
                        <property name="use-underline">True</property>
                        <signal name="toggled" handler="on_details_menu_view_autoconnect_activate" swapped="no"/>
                      </object>
                    </child>
                    <child>
                      <object class="GtkSeparator" id="separator7">
                        <property name="visible">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkCheckButton" id="details-menu-view-toolbar">
                        <property name="visible">True</property>
                        <property name="label" translatable="1">T_oolbar</property>
                        <property name="use-underline">True</property>
                        <property name="active">True</property>
                        <signal name="toggled" handler="on_details_menu_view_toolbar_activate" swapped="no"/>
                      </object>
                    </child>
                  </object></property></object>
                </property></object>
            </child>
            <child>
              <object class="GtkMenuButton" id="details-menu-send-key">
                <property name="visible">True</property>
                <property name="has-frame">False</property>
                <property name="direction">none</property>
                <property name="label" translatable="1">Send _Key</property>
                <property name="use-underline">True</property>
              <property name="popover"><object class="GtkPopover" id="details-menu-send-key-popover"><property name="child"><object class="GtkBox" id="details-menu-send-key-popover-items"><property name="orientation">vertical</property></object></property></object></property></object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="toolbar-box">
            <style>
              <class name="vmm-toolbar"/>
            </style>
            <child>
              <object class="GtkBox" id="details-toolbar">
                <property name="css-classes">toolbar</property>
                <property name="hexpand">1</property>
                <child>
                  <object class="GtkToggleButton" id="control-vm-console">
                    <property name="tooltip-text" translatable="1">Show the graphical console</property>
                    <property name="label" translatable="1">Console</property>
                    <property name="icon-name">icon_console</property>
                    <property name="active">1</property>
                    <signal name="toggled" handler="on_control_vm_console_toggled" swapped="no"/>
                  </object>
                </child>
                <child>
                  <object class="GtkToggleButton" id="control-vm-details">
                    <property name="tooltip-text" translatable="1">Show virtual hardware details</property>
                    <property name="label" translatable="1">Details</property>
                    <property name="icon-name">dialog-information</property>
                    <property name="group">control-vm-console</property>
                    <signal name="toggled" handler="on_control_vm_details_toggled" swapped="no"/>
                  </object>
                </child>
                <child>
                  <object class="GtkSeparator" id="toolbutton3">
                    <property name="orientation">vertical</property>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="control-run">
                    <property name="tooltip-text" translatable="1">Power on the virtual machine</property>
                    <property name="label" translatable="1">Run</property>
                    <property name="use-underline">1</property>
                    <property name="icon-name">media-playback-start</property>
                    <signal name="clicked" handler="on_control_run_clicked" swapped="no"/>
                  </object>
                </child>
                <child>
                  <object class="GtkToggleButton" id="control-pause">
                    <property name="tooltip-text" translatable="1">Pause the virtual machine</property>
                    <property name="label" translatable="1">Pause</property>
                    <property name="use-underline">1</property>
                    <property name="icon-name">media-playback-pause</property>
                    <signal name="toggled" handler="on_control_pause_toggled" swapped="no"/>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="control-shutdown">
                    <property name="visible">True</property>
                    <property name="tooltip-text" translatable="1">Shut down the virtual machine</property>
                    <property name="label" translatable="1">_Shut Down</property>
                    <property name="use-underline">True</property>
                    <signal name="clicked" handler="on_control_shutdown_clicked" swapped="no"/>
                  </object>
                </child>
                <child><object class="GtkMenuButton" id="control-shutdown-menu"><property name="icon-name">pan-down-symbolic</property><property name="tooltip-text">Shut down options</property></object></child><child>
                  <object class="GtkSeparator" id="toolbutton7">
                    <property name="orientation">vertical</property>
                  </object>
                </child>
                <child>
                  <object class="GtkToggleButton" id="control-snapshots">
                    <property name="label" translatable="1">Snapshots</property>
                    <property name="icon-name">vm_clone_wizard</property>
                    <property name="group">control-vm-console</property>
                    <signal name="toggled" handler="on_control_snapshots_toggled" swapped="no"/>
                  </object>
                </child>
                <child>
                  <object class="GtkToggleButton" id="control-fullscreen">
                    <property name="tooltip-text" translatable="1">Switch to fullscreen view</property>
                    <property name="halign">end</property>
                    <property name="icon-name">view-fullscreen</property>
                    <signal name="toggled" handler="on_control_fullscreen_toggled" swapped="no"/>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="customize-toolbar">
                <property name="visible">False</property>
                <property name="css-classes">toolbar</property>
                <property name="hexpand">1</property>
                <child>
                  <object class="GtkButton" id="details-finish-customize">
                    <property name="tooltip-text" translatable="1">Begin Installation</property>
                    <property name="css-classes">suggested-action</property>
                    <property name="label" translatable="1">_Begin Installation</property>
                    <property name="use-underline">1</property>
                    <signal name="clicked" handler="on_details_customize_finish_clicked" swapped="no"/>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="details-cancel-customize">
                    <property name="label" translatable="1">_Cancel Installation</property>
                    <property name="use-underline">1</property>
                    <signal name="clicked" handler="on_details_cancel_customize_clicked" swapped="no"/>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkNotebook" id="details-pages">
            <property name="vexpand">1</property>
            <property name="focusable">1</property>
            <property name="show-border">0</property>
            <signal name="switch-page" handler="on_details_pages_switch_page" after="yes" swapped="no"/>
            <child>
              <object class="GtkNotebookPage">
                <property name="child">
                  <object class="GtkBox" id="details-placeholder">
                    <child>
                      <placeholder/>
                    </child>
                  </object>
                </property>
                <property name="tab">
                  <object class="GtkLabel" id="label77">
                    <property name="label">Details</property>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkNotebookPage">
                <property name="position">1</property>
                <property name="child">
                  <object class="GtkBox" id="console-placeholder">
                    <child>
                      <placeholder/>
                    </child>
                  </object>
                </property>
                <property name="tab">
                  <object class="GtkLabel" id="label420">
                    <property name="label">Console</property>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkNotebookPage">
                <property name="position">2</property>
                <property name="child">
                  <object class="GtkBox" id="snapshot-placeholder">
                    <property name="orientation">vertical</property>
                    <child>
                      <placeholder/>
                    </child>
                  </object>
                </property>
                <property name="tab">
                  <object class="GtkLabel" id="label88">
                    <property name="label">Snapshots</property>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </property>
  </object>
</interface>
