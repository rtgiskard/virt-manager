<?xml version='1.0' encoding='UTF-8'?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <object class="GtkWindow" id="vmm-manager">
    <property name="title" translatable="1">Virtual Machine Manager</property>
    <property name="default-width">760</property>
    <property name="default-height">560</property>
    <signal name="close-request" handler="on_vm_manager_delete_event" swapped="no"/>
    <property name="child">
      <object class="GtkBox" id="vbox1">
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkBox" id="menubar1">
            <property name="valign">center</property>
            <property name="visible">True</property>
            <style>
              <class name="vmm-menubar"/>
            </style>
            <child>
              <object class="GtkMenuButton" id="menuitem4">
                <property name="visible">True</property>
                <property name="label" translatable="1">_File</property>
                <property name="use-underline">True</property>
                <property name="popover"><object class="GtkPopover" id="menuitem4_menu">
                    <property name="child"><object class="GtkBox" id="menuitem4_menu-items"><property name="orientation">vertical</property><child>
                      <object class="GtkButton" id="open_connection">
                        <property name="visible">True</property>
                        <property name="label" translatable="1">_Add Connection...</property>
                        <property name="use-underline">True</property>
                        <signal name="clicked" handler="on_menu_file_add_connection_activate" swapped="no"/>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="menu-new-vm">
                        <property name="visible">True</property>
                        <property name="label" translatable="1">_New Virtual Machine</property>
                        <property name="use-underline">True</property>
                        <signal name="clicked" handler="on_menu_new_vm_activate" swapped="no"/>
                      </object>
                    </child>
                    <child>
                      <object class="GtkSeparator" id="separatormenuitem1">
                        <property name="visible">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="menu_file_close">
                        <property name="visible">True</property>
                        <property name="label" translatable="1">_Close</property>
                        <property name="use-underline">True</property>
                        <signal name="clicked" handler="on_menu_file_close_activate" swapped="no"/>
                        </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="menu_file_quit">
                        <property name="visible">True</property>
                        <property name="label" translatable="1">_Quit</property>
                        <property name="use-underline">True</property>
                        <signal name="clicked" handler="on_menu_file_quit_activate" swapped="no"/>
                        </object>
                    </child>
                  </object></property></object>
                </property></object>
            </child>
            <child>
              <object class="GtkMenuButton" id="menuitem5">
                <property name="visible">True</property>
                <property name="label" translatable="1">_Edit</property>
                <property name="use-underline">True</property>
                <property name="popover"><object class="GtkPopover" id="menuitem5_menu">
                    <property name="child"><object class="GtkBox" id="menuitem5_menu-items"><property name="orientation">vertical</property><child>
                      <object class="GtkButton" id="menu_host_details">
                        <property name="visible">True</property>
                        <property name="label" translatable="1">_Connection Details</property>
                        <property name="use-underline">True</property>
                        <signal name="clicked" handler="on_menu_host_details_activate" swapped="no"/>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="menu_edit_details">
                        <property name="visible">True</property>
                        <property name="label" translatable="1">_Virtual Machine Details</property>
                        <property name="use-underline">True</property>
                        <signal name="clicked" handler="on_menu_edit_details_activate" swapped="no"/>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="menu_edit_delete">
                        <property name="visible">True</property>
                        <property name="label" translatable="1">_Delete</property>
                        <property name="use-underline">True</property>
                        <signal name="clicked" handler="on_menu_edit_delete_activate" swapped="no"/>
                      </object>
                    </child>
                    <child>
                      <object class="GtkSeparator" id="separator2">
                        <property name="visible">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="menu_edit_preferences">
                        <property name="visible">True</property>
                        <property name="label" translatable="1">_Preferences</property>
                        <property name="use-underline">True</property>
                        <signal name="clicked" handler="on_menu_edit_preferences_activate" swapped="no"/>
                      </object>
                    </child>
                  </object></property></object>
                </property></object>
            </child>
            <child>
              <object class="GtkMenuButton" id="menuitem6">
                <property name="visible">True</property>
                <property name="label" translatable="1">_View</property>
                <property name="use-underline">True</property>
                <property name="popover"><object class="GtkPopover" id="menuitem6_menu">
                    <property name="child"><object class="GtkBox" id="menuitem6_menu-items"><property name="orientation">vertical</property><child>
                      <object class="GtkExpander" id="menuitem1">
                        <property name="visible">True</property>
                        <property name="label" translatable="1">_Graph</property>
                        <property name="use-underline">True</property>
                        <property name="child"><object class="GtkBox" id="menu1"><property name="orientation">vertical</property><child>
                              <object class="GtkCheckButton" id="menu_view_stats_guest_cpu">
                                <property name="visible">True</property>
                                <property name="label" translatable="1">_Guest CPU Usage</property>
                                <property name="use-underline">True</property>
                                <property name="active">True</property>
                                <signal name="toggled" handler="on_menu_view_guest_cpu_usage_activate" swapped="no"/>
                              </object>
                            </child>
                            <child>
                              <object class="GtkCheckButton" id="menu_view_stats_host_cpu">
                                <property name="visible">True</property>
                                <property name="label" translatable="1">_Host CPU Usage</property>
                                <property name="use-underline">True</property>
                                <signal name="toggled" handler="on_menu_view_host_cpu_usage_activate" swapped="no"/>
                              </object>
                            </child>
                            <child>
                              <object class="GtkCheckButton" id="menu_view_stats_memory">
                                <property name="visible">True</property>
                                <property name="label" translatable="1">_Memory Usage</property>
                                <property name="use-underline">True</property>
                                <signal name="toggled" handler="on_menu_view_memory_usage_activate" swapped="no"/>
                              </object>
                            </child>
                            <child>
                              <object class="GtkCheckButton" id="menu_view_stats_disk">
                                <property name="visible">True</property>
                                <property name="label" translatable="1">_Disk I/O</property>
                                <property name="use-underline">True</property>
                                <property name="active">True</property>
                                <signal name="toggled" handler="on_menu_view_disk_io_activate" swapped="no"/>
                              </object>
                            </child>
                            <child>
                              <object class="GtkCheckButton" id="menu_view_stats_network">
                                <property name="visible">True</property>
                                <property name="label" translatable="1">_Network I/O</property>
                                <property name="use-underline">True</property>
                                <property name="active">True</property>
                                <signal name="toggled" handler="on_menu_view_network_traffic_activate" swapped="no"/>
                              </object>
                            </child>
                          </object></property></object>
                    </child>
                  </object></property></object>
                </property></object>
            </child>
            <child>
              <object class="GtkMenuButton" id="menuitem7">
                <property name="visible">True</property>
                <property name="label" translatable="1">_Help</property>
                <property name="use-underline">True</property>
                <property name="popover"><object class="GtkPopover" id="menuitem7_menu">
                    <property name="child"><object class="GtkBox" id="menuitem7_menu-items"><property name="orientation">vertical</property><child>
                      <object class="GtkButton" id="menu_help_about">
                        <property name="visible">True</property>
                        <property name="label" translatable="1">_About</property>
                        <property name="use-underline">True</property>
                        <signal name="clicked" handler="on_menu_help_about_activate" swapped="no"/>
                      </object>
                    </child>
                  </object></property></object>
                </property></object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="vbox2">
            <property name="vexpand">1</property>
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkBox" id="vm-toolbar">
                <property name="css-classes">toolbar</property>
                <style>
                  <class name="vmm-toolbar"/>
                </style>
                <child>
                  <object class="GtkButton" id="vm-new">
                    <property name="has-tooltip">1</property>
                    <property name="tooltip-text" translatable="1">Create a new virtual machine</property>
                    <property name="label" translatable="1">New</property>
                    <property name="use-underline">1</property>
                    <property name="icon-name">vm_new_large</property>
                    <signal name="clicked" handler="on_vm_new_clicked" swapped="no"/>
                  </object>
                </child>
                <child>
                  <object class="GtkSeparator" id="toolbutton1">
                    <property name="orientation">vertical</property>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="vm-open">
                    <property name="has-tooltip">1</property>
                    <property name="tooltip-text" translatable="1">Show the virtual machine console and details</property>
                    <property name="label" translatable="1">_Open</property>
                    <property name="use-underline">1</property>
                    <property name="icon-name">icon_console</property>
                    <signal name="clicked" handler="on_vm_open_clicked" swapped="no"/>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="vm-run">
                    <property name="has-tooltip">1</property>
                    <property name="tooltip-text" translatable="1">Power on the virtual machine</property>
                    <property name="label" translatable="1">_Run</property>
                    <property name="use-underline">1</property>
                    <property name="icon-name">media-playback-start</property>
                    <signal name="clicked" handler="on_vm_run_clicked" swapped="no"/>
                  </object>
                </child>
                <child>
                  <object class="GtkToggleButton" id="vm-pause">
                    <property name="has-tooltip">1</property>
                    <property name="tooltip-text" translatable="1">Pause the virtual machine</property>
                    <property name="label" translatable="1">_Pause</property>
                    <property name="use-underline">1</property>
                    <property name="icon-name">media-playback-pause</property>
                    <signal name="clicked" handler="on_vm_pause_clicked" swapped="no"/>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="vm-shutdown">
                    <property name="visible">True</property>
                    <property name="has-tooltip">True</property>
                    <property name="tooltip-text" translatable="1">Shut down the virtual machine</property>
                    <property name="label" translatable="1">_Shut Down</property>
                    <property name="use-underline">True</property>
                    <signal name="clicked" handler="on_vm_shutdown_clicked" swapped="no"/>
                  </object>
                </child>
              <child><object class="GtkMenuButton" id="vm-shutdown-menu"><property name="icon-name">pan-down-symbolic</property><property name="tooltip-text">Shut down options</property></object></child></object>
            </child>
            <child>
              <object class="GtkNotebook" id="vm-notebook">
                <property name="vexpand">1</property>
                <property name="focusable">1</property>
                <property name="show-border">0</property>
                <child>
                  <object class="GtkNotebookPage">
                    <property name="child">
                      <object class="GtkScrolledWindow" id="scrolledwindow1">
                        <property name="focusable">1</property>
                        <property name="child">
                          <object class="GtkTreeView" id="vm-list">
                            <property name="focusable">1</property>
                            <signal name="row-activated" handler="on_vm_list_row_activated" swapped="no"/>
                            <child internal-child="selection">
                              <object class="GtkTreeSelection" id="treeview-selection1">
                                <property name="mode">browse</property>
                              </object>
                            </child>
                            </object>
                        </property>
                      </object>
                    </property>
                    <property name="tab">
                      <object class="GtkLabel" id="label1">
                        <property name="label">manager</property>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="GtkNotebookPage">
                    <property name="position">1</property>
                    <property name="child">
                      <object class="GtkLabel" id="startup-error-label">
                        <property name="halign">center</property>
                        <property name="label">error</property>
                        <property name="wrap">1</property>
                        <property name="selectable">1</property>
                        <property name="max-width-chars">40</property>
                        </object>
                    </property>
                    <property name="tab">
                      <object class="GtkLabel" id="label2">
                        <property name="label">error</property>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </property>
  </object>
</interface>
