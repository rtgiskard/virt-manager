<?xml version='1.0' encoding='UTF-8'?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <object class="GtkWindow" id="vmm-create-net">
    <property name="width-request">400</property>
    <property name="height-request">400</property>
    <property name="title" translatable="1">Create a new virtual network</property>
    <signal name="close-request" handler="on_vmm_create_delete_event" swapped="no"/>
    <property name="child">
      <object class="GtkBox" id="box1">
        <property name="orientation">vertical</property>
        <property name="spacing">6</property>
        <child>
          <object class="GtkViewport" id="header">
            <property name="child">
              <object class="GtkBox" id="box77">
                <property name="spacing">10</property>
                <child>
                  <object class="GtkImage" id="image3">
                    <property name="halign">center</property>
                    <property name="icon-name">network-idle</property>
                    <property name="pixel-size">48</property>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="hbox2">
                    <property name="hexpand">1</property>
                    <child>
                      <object class="GtkBox" id="vbox3">
                        <property name="hexpand">1</property>
                        <property name="orientation">vertical</property>
                        <child>
                          <object class="GtkLabel" id="label2">
                            <property name="halign">start</property>
                            <property name="label" translatable="1">&lt;span size='large'&gt;Create virtual network&lt;/span&gt;</property>
                            <property name="use-markup">1</property>
                            <style>
                              <class name="vmm-header-text"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              <property name="margin-start">6</property><property name="margin-end">6</property><property name="margin-top">6</property><property name="margin-bottom">6</property></object>
            </property>
            <style>
              <class name="vmm-header"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="vbox23">
            <property name="vexpand">1</property>
            <property name="orientation">vertical</property>
            <property name="spacing">12</property>
            <child>
              <object class="GtkBox" id="net-details-align">
                <property name="vexpand">1</property>
                <child>
                  <object class="GtkBox" id="net-details">
                    <property name="orientation">vertical</property>
                    <property name="spacing">12</property>
                    <child>
                      <object class="GtkGrid">
                        <property name="row-spacing">6</property>
                        <property name="column-spacing">6</property>
                        <child>
                          <object class="GtkComboBox" id="net-forward-mode">
                            <property name="halign">start</property>
                            <signal name="changed" handler="on_net_forward_mode_changed" swapped="no"/>
                            <layout>
                              <property name="column">1</property>
                              <property name="row">1</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel">
                            <property name="halign">end</property>
                            <property name="label" translatable="1">_Mode:</property>
                            <property name="use-underline">1</property>
                            <layout>
                              <property name="column">0</property>
                              <property name="row">1</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="label392">
                            <property name="halign">end</property>
                            <property name="label" translatable="1">Fo_rward to:</property>
                            <property name="use-underline">1</property>
                            <property name="mnemonic-widget">net-forward-device</property>
                            <layout>
                              <property name="column">0</property>
                              <property name="row">2</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="label393">
                            <property name="halign">end</property>
                            <property name="label" translatable="1">Device _List:</property>
                            <property name="use-underline">1</property>
                            <property name="mnemonic-widget">net-forward-device</property>
                            <layout>
                              <property name="column">0</property>
                              <property name="row">4</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkComboBox" id="net-forward-device">
                            <signal name="changed" handler="on_net_forward_device_changed" swapped="no"/>
                            <layout>
                              <property name="column">1</property>
                              <property name="row">2</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkComboBox" id="net-hostdevs">
                            <property name="width-request">200</property>
                            <property name="halign">start</property>
                            <layout>
                              <property name="column">1</property>
                              <property name="row">4</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="label173">
                            <property name="halign">end</property>
                            <property name="label" translatable="1">_Name:</property>
                            <property name="use-markup">1</property>
                            <property name="use-underline">1</property>
                            <property name="justify">right</property>
                            <property name="mnemonic-widget">net-name</property>
                            <layout>
                              <property name="column">0</property>
                              <property name="row">0</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkEntry" id="net-name">
                            <property name="focusable">1</property>
                            <property name="width-chars">25</property>
                            <layout>
                              <property name="column">1</property>
                              <property name="row">0</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel">
                            <property name="visible">0</property>
                            <property name="halign">end</property>
                            <property name="label" translatable="1">De_vice:</property>
                            <property name="use-underline">1</property>
                            <property name="justify">right</property>
                            <property name="mnemonic-widget">net-forward-manual</property>
                            <layout>
                              <property name="column">0</property>
                              <property name="row">3</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkEntry" id="net-forward-manual">
                            <property name="visible">0</property>
                            <property name="focusable">1</property>
                            <layout>
                              <property name="column">1</property>
                              <property name="row">3</property>
                            </layout>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkExpander" id="net-ipv4-expander">
                        <property name="focusable">1</property>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">6</property>
                            <child>
                              <object class="GtkCheckButton" id="net-ipv4-enable">
                                <property name="label" translatable="1">_Enable IPv4</property>
                                <property name="focusable">1</property>
                                <property name="halign">start</property>
                                <property name="use-underline">1</property>
                                <property name="active">1</property>
                                <signal name="toggled" handler="on_net-ipv4-enable_toggled" swapped="no"/>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox" id="net-ipv4-box">
                                <property name="margin-start">15</property>
                                <property name="orientation">vertical</property>
                                <property name="spacing">6</property>
                                <child>
                                  <object class="GtkBox" id="box5">
                                    <property name="orientation">vertical</property>
                                    <property name="spacing">3</property>
                                    <child>
                                      <object class="GtkBox" id="box6">
                                        <property name="spacing">6</property>
                                        <child>
                                          <object class="GtkLabel" id="label385">
                                            <property name="halign">end</property>
                                            <property name="label" translatable="1">_Network:</property>
                                            <property name="use-underline">1</property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkEntry" id="net-ipv4-network">
                                            <property name="focusable">1</property>
                                            <property name="halign">start</property>
                                            <property name="max-length">20</property>
                                            <property name="invisible-char">●</property>
                                            <property name="width-chars">25</property>
                                            <signal name="changed" handler="on_net-ipv4-network_changed" swapped="no"/>
                                            </object>
                                        </child>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkGrid" id="table5">
                                    <property name="row-spacing">3</property>
                                    <property name="column-spacing">6</property>
                                    <child>
                                      <object class="GtkEntry" id="net-dhcpv4-start">
                                        <property name="focusable">1</property>
                                        <property name="max-length">15</property>
                                        <property name="invisible-char">●</property>
                                        <property name="width-chars">25</property>
                                        <layout>
                                          <property name="column">1</property>
                                          <property name="row">1</property>
                                        </layout>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkEntry" id="net-dhcpv4-end">
                                        <property name="focusable">1</property>
                                        <property name="max-length">15</property>
                                        <property name="invisible-char">●</property>
                                        <layout>
                                          <property name="column">1</property>
                                          <property name="row">2</property>
                                        </layout>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel" id="label26">
                                        <property name="halign">end</property>
                                        <property name="label" translatable="1">Start:</property>
                                        <layout>
                                          <property name="column">0</property>
                                          <property name="row">1</property>
                                        </layout>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel" id="label27">
                                        <property name="halign">end</property>
                                        <property name="label" translatable="1">End:</property>
                                        <layout>
                                          <property name="column">0</property>
                                          <property name="row">2</property>
                                        </layout>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkCheckButton" id="net-dhcpv4-enable">
                                        <property name="label" translatable="1">Enable DHCPv4</property>
                                        <property name="focusable">1</property>
                                        <property name="halign">start</property>
                                        <property name="active">1</property>
                                        <signal name="toggled" handler="on_net-dhcpv4-enable_toggled" swapped="no"/>
                                        <layout>
                                          <property name="column">0</property>
                                          <property name="row">0</property>
                                          <property name="column-span">2</property>
                                        </layout>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child type="label">
                          <object class="GtkLabel">
                            <property name="label" translatable="1">&lt;b&gt;IPv_4 configuration&lt;/b&gt;</property>
                            <property name="use-markup">1</property>
                            <property name="use-underline">1</property>
                            <property name="mnemonic-widget">net-ipv4-expander</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkExpander" id="net-ipv6-expander">
                        <property name="focusable">1</property>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">6</property>
                            <child>
                              <object class="GtkCheckButton" id="net-ipv6-enable">
                                <property name="label" translatable="1">_Enable IPv6</property>
                                <property name="focusable">1</property>
                                <property name="halign">start</property>
                                <property name="use-underline">1</property>
                                <property name="active">1</property>
                                <signal name="toggled" handler="on_net-ipv6-enable_toggled" swapped="no"/>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox" id="net-ipv6-box">
                                <property name="margin-start">15</property>
                                <property name="orientation">vertical</property>
                                <property name="spacing">6</property>
                                <child>
                                  <object class="GtkBox" id="box9">
                                    <property name="valign">center</property>
                                    <property name="orientation">vertical</property>
                                    <property name="spacing">3</property>
                                    <child>
                                      <object class="GtkBox" id="box10">
                                        <property name="spacing">6</property>
                                        <child>
                                          <object class="GtkLabel" id="label12">
                                            <property name="halign">end</property>
                                            <property name="label" translatable="1">_Network:</property>
                                            <property name="use-underline">1</property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkEntry" id="net-ipv6-network">
                                            <property name="focusable">1</property>
                                            <property name="halign">start</property>
                                            <property name="max-length">40</property>
                                            <property name="invisible-char">●</property>
                                            <property name="width-chars">25</property>
                                            <signal name="changed" handler="on_net-ipv6-network_changed" swapped="no"/>
                                            </object>
                                        </child>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkGrid" id="table6">
                                    <property name="row-spacing">3</property>
                                    <property name="column-spacing">6</property>
                                    <child>
                                      <object class="GtkEntry" id="net-dhcpv6-start">
                                        <property name="focusable">1</property>
                                        <property name="max-length">40</property>
                                        <property name="invisible-char">●</property>
                                        <property name="width-chars">25</property>
                                        <layout>
                                          <property name="column">1</property>
                                          <property name="row">1</property>
                                        </layout>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkEntry" id="net-dhcpv6-end">
                                        <property name="focusable">1</property>
                                        <property name="max-length">40</property>
                                        <property name="invisible-char">●</property>
                                        <layout>
                                          <property name="column">1</property>
                                          <property name="row">2</property>
                                        </layout>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel" id="label29">
                                        <property name="halign">end</property>
                                        <property name="label" translatable="1">Start:</property>
                                        <layout>
                                          <property name="column">0</property>
                                          <property name="row">1</property>
                                        </layout>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel" id="label38">
                                        <property name="halign">start</property>
                                        <property name="label" translatable="1">End:</property>
                                        <layout>
                                          <property name="column">0</property>
                                          <property name="row">2</property>
                                        </layout>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkCheckButton" id="net-dhcpv6-enable">
                                        <property name="label" translatable="1">Enable DHCPv6</property>
                                        <property name="focusable">1</property>
                                        <property name="halign">start</property>
                                        <property name="active">1</property>
                                        <signal name="toggled" handler="on_net-dhcpv6-enable_toggled" swapped="no"/>
                                        <layout>
                                          <property name="column">0</property>
                                          <property name="row">0</property>
                                          <property name="column-span">2</property>
                                        </layout>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child type="label">
                          <object class="GtkLabel">
                            <property name="label" translatable="1">&lt;b&gt;IPv_6 configuration&lt;/b&gt;</property>
                            <property name="use-markup">1</property>
                            <property name="use-underline">1</property>
                            <property name="mnemonic-widget">net-ipv6-expander</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkExpander" id="net-dns-expander">
                        <property name="focusable">1</property>
                        <child>
                          <object class="GtkGrid">
                            <property name="margin-start">15</property>
                            <property name="row-spacing">6</property>
                            <property name="column-spacing">6</property>
                            <child>
                              <object class="GtkEntry" id="net-domain-name">
                                <property name="focusable">1</property>
                                <property name="invisible-char">●</property>
                                <property name="width-chars">20</property>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">1</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkCheckButton" id="net-dns-use-netname">
                                <property name="label" translatable="1">Use net_work name</property>
                                <property name="focusable">1</property>
                                <property name="halign">start</property>
                                <property name="use-underline">1</property>
                                <property name="active">1</property>
                                <property name="group">net-dns-use-custom</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">0</property>
                                  <property name="column-span">2</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkCheckButton" id="net-dns-use-custom">
                                <property name="label" translatable="1">Cust_om</property>
                                <property name="focusable">1</property>
                                <property name="use-underline">1</property>
                                <signal name="toggled" handler="on_net_dns_use_toggled" swapped="no"/>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">1</property>
                                </layout>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child type="label">
                          <object class="GtkLabel">
                            <property name="label" translatable="1">&lt;b&gt;DNS domain name&lt;/b&gt;</property>
                            <property name="use-markup">1</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="hbuttonbox1">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="spacing">12</property>
                <child>
                  <object class="GtkButton" id="create-cancel">
                    <property name="label" translatable="1">_Cancel</property>
                    <property name="focusable">1</property>
                    <property name="receives-default">1</property>
                    <property name="use-underline">1</property>
                    <signal name="clicked" handler="on_create_cancel_clicked" swapped="no"/>
                  </object>
                  </child>
                <child>
                  <object class="GtkButton" id="create-finish">
                    <property name="label" translatable="1">_Finish</property>
                    <property name="focusable">1</property>
                    <property name="receives-default">1</property>
                    <property name="use-underline">1</property>
                    <signal name="clicked" handler="on_create_finish_clicked" swapped="no"/>
                  </object>
                  </child>
              </object>
            </child>
          <property name="margin-start">12</property><property name="margin-end">12</property><property name="margin-top">12</property><property name="margin-bottom">12</property></object>
        </child>
      </object>
    </property>
  </object>
</interface>
