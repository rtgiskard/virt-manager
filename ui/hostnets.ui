<?xml version='1.0' encoding='UTF-8'?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <object class="GtkBox" id="top-box">
    <property name="width-request">400</property>
    <property name="height-request">400</property>
    <property name="orientation">vertical</property>
    <child>
      <object class="GtkPaned" id="hpaned2">
        <property name="resize-start-child">0</property>
        <property name="vexpand">1</property>
        <property name="focusable">1</property>
        <property name="position">200</property>
        <property name="position-set">1</property>
        <property name="start-child">
          <object class="GtkScrolledWindow" id="scrolledwindow7">
            <property name="focusable">1</property>
            <property name="hscrollbar-policy">never</property>
            <property name="child">
              <object class="GtkTreeView" id="net-list">
                <property name="width-request">134</property>
                <property name="focusable">1</property>
                <property name="headers-visible">0</property>
                <child internal-child="selection">
                  <object class="GtkTreeSelection">
                    <signal name="changed" handler="on_net_list_changed" swapped="no"/>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </property>
        <property name="end-child">
          <object class="GtkNotebook" id="network-pages">
            <property name="focusable">1</property>
            <property name="show-border">0</property>
            <child>
              <object class="GtkNotebookPage">
                <property name="child">
                  <object class="GtkBox" id="net-details-align">
                    <child>
                      <object class="GtkBox" id="net-details">
                        <property name="orientation">vertical</property>
                        <property name="spacing">12</property>
                        <child>
                          <object class="GtkGrid" id="table4">
                            <property name="row-spacing">5</property>
                            <property name="column-spacing">6</property>
                            <child>
                              <object class="GtkBox" id="hbox3">
                                <property name="spacing">3</property>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">2</property>
                                </layout>
                                <child>
                                  <object class="GtkImage" id="net-state-icon">
                                    <property name="icon-name">image-missing</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="net-state">
                                    <property name="hexpand">1</property>
                                    <property name="halign">start</property>
                                    <property name="label">Running</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkCheckButton" id="net-autostart">
                                <property name="label">Some Label</property>
                                <property name="focusable">1</property>
                                <property name="halign">start</property>
                                <property name="use-underline">1</property>
                                <signal name="toggled" handler="on_net_autostart_toggled" swapped="no"/>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">3</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="net-device">
                                <property name="halign">start</property>
                                <property name="label">label</property>
                                <property name="selectable">1</property>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">1</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="net-name-domain">
                                <property name="halign">start</property>
                                <property name="label">label</property>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">4</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="label58">
                                <property name="halign">start</property>
                                <property name="label" translatable="1">Device:</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">1</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="label63">
                                <property name="halign">start</property>
                                <property name="label" translatable="1">State:</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">2</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="label70">
                                <property name="halign">start</property>
                                <property name="label" translatable="1">A_utostart:</property>
                                <property name="use-underline">1</property>
                                <property name="mnemonic-widget">net-autostart</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">3</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="label33">
                                <property name="halign">start</property>
                                <property name="label" translatable="1">Domain:</property>
                                <property name="use-markup">1</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">4</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="label5">
                                <property name="halign">start</property>
                                <property name="label" translatable="1">Name:</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">0</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkEntry" id="net-name">
                                <property name="focusable">1</property>
                                <signal name="changed" handler="on_net_name_changed" swapped="no"/>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">0</property>
                                </layout>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkExpander" id="net-ipv4-expander">
                            <property name="focusable">1</property>
                            <property name="expanded">1</property>
                            <child>
                              <object class="GtkGrid" id="table3">
                                <property name="row-spacing">5</property>
                                <property name="column-spacing">6</property>
                                <child>
                                  <object class="GtkLabel" id="net-ipv4-network">
                                    <property name="halign">start</property>
                                    <property name="label">label</property>
                                    <property name="selectable">1</property>
                                    <layout>
                                      <property name="column">1</property>
                                      <property name="row">0</property>
                                    </layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="net-ipv4-dhcp-range">
                                    <property name="halign">start</property>
                                    <property name="label">label</property>
                                    <property name="selectable">1</property>
                                    <layout>
                                      <property name="column">1</property>
                                      <property name="row">1</property>
                                    </layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="label52">
                                    <property name="halign">start</property>
                                    <property name="label" translatable="1">Network:</property>
                                    <layout>
                                      <property name="column">0</property>
                                      <property name="row">0</property>
                                    </layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="label54">
                                    <property name="halign">start</property>
                                    <property name="label" translatable="1">DHCP range:</property>
                                    <layout>
                                      <property name="column">0</property>
                                      <property name="row">1</property>
                                    </layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="label34">
                                    <property name="halign">start</property>
                                    <property name="label" translatable="1">Forwarding:</property>
                                    <layout>
                                      <property name="column">0</property>
                                      <property name="row">2</property>
                                    </layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkBox" id="hbox13">
                                    <property name="spacing">3</property>
                                    <layout>
                                      <property name="column">1</property>
                                      <property name="row">2</property>
                                    </layout>
                                    <child>
                                      <object class="GtkLabel" id="net-ipv4-forwarding">
                                        <property name="hexpand">1</property>
                                        <property name="halign">start</property>
                                        <property name="label" translatable="1">NAT to any device</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child type="label">
                              <object class="GtkLabel" id="label27">
                                <property name="label" translatable="1">&lt;b&gt;IPv_4 configuration&lt;/b&gt;</property>
                                <property name="use-markup">1</property>
                                <property name="use-underline">1</property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkExpander" id="net-ipv6-expander">
                            <property name="focusable">1</property>
                            <property name="expanded">1</property>
                            <child>
                              <object class="GtkGrid" id="table9">
                                <property name="row-spacing">5</property>
                                <property name="column-spacing">6</property>
                                <child>
                                  <object class="GtkLabel" id="net-ipv6-network">
                                    <property name="halign">start</property>
                                    <property name="label">label</property>
                                    <property name="selectable">1</property>
                                    <layout>
                                      <property name="column">1</property>
                                      <property name="row">0</property>
                                    </layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="net-ipv6-dhcp-range">
                                    <property name="halign">start</property>
                                    <property name="label">label</property>
                                    <property name="selectable">1</property>
                                    <layout>
                                      <property name="column">1</property>
                                      <property name="row">1</property>
                                    </layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="label39">
                                    <property name="halign">start</property>
                                    <property name="label" translatable="1">Network:</property>
                                    <layout>
                                      <property name="column">0</property>
                                      <property name="row">0</property>
                                    </layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="label40">
                                    <property name="halign">start</property>
                                    <property name="label" translatable="1">DHCP range:</property>
                                    <layout>
                                      <property name="column">0</property>
                                      <property name="row">1</property>
                                    </layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="label26">
                                    <property name="halign">start</property>
                                    <property name="label" translatable="1">Forwarding:</property>
                                    <layout>
                                      <property name="column">0</property>
                                      <property name="row">2</property>
                                    </layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="net-ipv6-forwarding">
                                    <property name="halign">start</property>
                                    <property name="label" translatable="1">Routed</property>
                                    <layout>
                                      <property name="column">1</property>
                                      <property name="row">2</property>
                                    </layout>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child type="label">
                              <object class="GtkLabel" id="label43">
                                <property name="label" translatable="1">&lt;b&gt;IPv_6 configuration&lt;/b&gt;</property>
                                <property name="use-markup">1</property>
                                <property name="use-underline">1</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </property>
                <property name="tab">
                  <object class="GtkLabel" id="label3">
                    <property name="label">info</property>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkNotebookPage">
                <property name="position">1</property>
                <property name="child">
                  <object class="GtkLabel" id="network-error-label">
                    <property name="label">some error here</property>
                  </object>
                </property>
                <property name="tab">
                  <object class="GtkLabel" id="label21">
                    <property name="label">error</property>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </property>
        <property name="margin-start">3</property>
        <property name="margin-end">3</property>
        <property name="margin-top">3</property>
        <property name="margin-bottom">3</property>
      </object>
    </child>
    <child>
      <object class="GtkBox" id="hbox15">
        <child>
          <object class="GtkBox" id="hbox16">
            <property name="hexpand">1</property>
            <child>
              <object class="GtkButton" id="net-add">
                <property name="halign">center</property>
                <property name="focusable">1</property>
                <property name="tooltip-text" translatable="1">Add Network</property>
                <signal name="clicked" handler="on_net_add_clicked" swapped="no"/>
                <child>
                  <object class="GtkImage" id="image10">
                    <property name="icon-name">list-add</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="net-start">
                <property name="halign">center</property>
                <property name="focusable">1</property>
                <property name="tooltip-text" translatable="1">Start Network</property>
                <signal name="clicked" handler="on_net_start_clicked" swapped="no"/>
                <child>
                  <object class="GtkImage" id="image11">
                    <property name="icon-name">media-playback-start</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="net-stop">
                <property name="halign">center</property>
                <property name="focusable">1</property>
                <property name="tooltip-text" translatable="1">Stop Network</property>
                <signal name="clicked" handler="on_net_stop_clicked" swapped="no"/>
                <child>
                  <object class="GtkImage" id="image12">
                    <property name="icon-name">process-stop</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="net-delete">
                <property name="halign">center</property>
                <property name="focusable">1</property>
                <property name="tooltip-text" translatable="1">Delete Network</property>
                <signal name="clicked" handler="on_net_delete_clicked" swapped="no"/>
                <child>
                  <object class="GtkImage" id="image13">
                    <property name="icon-name">edit-delete</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="hbox17">
            <child>
              <object class="GtkButton" id="net-apply">
                <property name="halign">center</property>
                <property name="label" translatable="1">_Apply</property>
                <property name="focusable">1</property>
                <property name="use-underline">1</property>
                <signal name="clicked" handler="on_net_apply_clicked" swapped="no"/>
              </object>
            </child>
          </object>
        </child>
        <property name="margin-start">3</property>
        <property name="margin-end">3</property>
        <property name="margin-top">3</property>
        <property name="margin-bottom">3</property>
      </object>
    </child>
    <property name="margin-start">3</property>
    <property name="margin-end">3</property>
    <property name="margin-top">3</property>
    <property name="margin-bottom">3</property>
  </object>
</interface>
