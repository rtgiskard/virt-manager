<?xml version='1.0' encoding='UTF-8'?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <object class="GtkWindow" id="vmm-host">
    <property name="width-request">800</property>
    <property name="height-request">600</property>
    <property name="title">Connection Details</property>
    <property name="default-width">750</property>
    <property name="default-height">500</property>
    <signal name="close-request" handler="on_vmm_host_delete_event" swapped="no"/>
    <property name="child">
      <object class="GtkBox" id="vbox1">
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkBox" id="menubar1">
            <property name="valign">center</property>
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <child>
              <object class="GtkMenuButton" id="menuitem4">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="label" translatable="1">_File</property>
                <property name="use-underline">True</property>
                <property name="popover"><object class="GtkPopover" id="menuitem4_menu">
                    <property name="can-focus">False</property>
                    <property name="child"><object class="GtkBox" id="menuitem4_menu-items"><property name="orientation">vertical</property><child>
                      <object class="GtkButton" id="menu-file-view-manager">
                        <property name="visible">True</property>
                        <property name="can-focus">False</property>
                        <property name="label" translatable="1">_View Manager</property>
                        <property name="use-underline">True</property>
                        <signal name="clicked" handler="on_menu_file_view_manager_activate" swapped="no"/>
                      </object>
                    </child>
                    <child>
                      <object class="GtkSeparator" id="menuitem1">
                        <property name="visible">True</property>
                        <property name="can-focus">False</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="menu-file-close">
                        <property name="visible">True</property>
                        <property name="can-focus">False</property>
                        <property name="label">_Close</property>
                        <property name="use-underline">True</property>
                        <signal name="clicked" handler="on_menu_file_close_activate" swapped="no"/>
                        </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="menu-file-quit">
                        <property name="visible">True</property>
                        <property name="can-focus">False</property>
                        <property name="label">_Quit</property>
                        <property name="use-underline">True</property>
                        <signal name="clicked" handler="on_menu_file_quit_activate" swapped="no"/>
                        </object>
                    </child>
                  </object></property></object>
                </property></object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkNotebook" id="details-tabs">
            <property name="vexpand">1</property>
            <property name="focusable">1</property>
            <signal name="switch-page" handler="on_host_page_switch" swapped="no"/>
            <child>
              <object class="GtkNotebookPage">
                <property name="child">
                  <object class="GtkBox" id="box1">
                    <property name="orientation">vertical</property>
                    <child>
                      <object class="GtkBox" id="vbox2">
                        <property name="orientation">vertical</property>
                        <property name="spacing">18</property>
                        <child>
                          <object class="GtkFrame" id="frame1">
                            <property name="child">
                              <object class="GtkGrid" id="table1">
                                <property name="margin-start">12</property>
                                <property name="row-spacing">3</property>
                                <property name="column-spacing">6</property>
                                <child>
                                  <object class="GtkLabel" id="label71">
                                    <property name="halign">end</property>
                                    <property name="label" translatable="1">Libvirt URI:</property>
                                    <property name="lines">1</property>
                                    <layout>
                                      <property name="column">0</property>
                                      <property name="row">1</property>
                                    </layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="overview-uri">
                                    <property name="halign">start</property>
                                    <property name="label">example.com</property>
                                    <property name="selectable">1</property>
                                    <property name="ellipsize">end</property>
                                    <layout>
                                      <property name="column">1</property>
                                      <property name="row">1</property>
                                    </layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkCheckButton" id="config-autoconnect">
                                    <property name="focusable">1</property>
                                    <property name="use-underline">1</property>
                                    <signal name="toggled" handler="on_config_autoconnect_toggled" swapped="no"/>
                                    <layout>
                                      <property name="column">1</property>
                                      <property name="row">2</property>
                                    </layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkEntry" id="overview-name">
                                    <property name="focusable">1</property>
                                    <property name="max-width-chars">30</property>
                                    <signal name="changed" handler="on_overview_name_changed" swapped="no"/>
                                    <layout>
                                      <property name="column">1</property>
                                      <property name="row">0</property>
                                    </layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="label8">
                                    <property name="halign">end</property>
                                    <property name="label" translatable="1">_Name:</property>
                                    <property name="use-underline">1</property>
                                    <property name="mnemonic-widget">overview-name</property>
                                    <property name="lines">1</property>
                                    <layout>
                                      <property name="column">0</property>
                                      <property name="row">0</property>
                                    </layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="label72">
                                    <property name="halign">end</property>
                                    <property name="label" translatable="1">A_utoconnect:</property>
                                    <property name="use-underline">1</property>
                                    <property name="mnemonic-widget">config-autoconnect</property>
                                    <layout>
                                      <property name="column">0</property>
                                      <property name="row">2</property>
                                    </layout>
                                  </object>
                                </child>
                              <property name="margin-end">3</property><property name="margin-top">3</property><property name="margin-bottom">3</property></object>
                            </property>
                            <child type="label">
                              <object class="GtkLabel" id="label4">
                                <property name="label" translatable="1">&lt;b&gt;Basic details&lt;/b&gt;</property>
                                <property name="use-markup">1</property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox" id="box4">
                            <property name="vexpand">1</property>
                            <property name="orientation">vertical</property>
                            <child>
                              <object class="GtkFrame" id="frame3">
                                <property name="vexpand">1</property>
                                <property name="child">
                                  <object class="GtkBox" id="box2">
                                    <property name="margin-start">12</property>
                                    <property name="orientation">vertical</property>
                                    <property name="spacing">3</property>
                                    <child>
                                      <object class="GtkBox" id="performance-cpu-align">
                                        <property name="height-request">75</property>
                                        <child>
                                          <placeholder/>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel" id="performance-cpu">
                                        <property name="halign">end</property>
                                        <property name="label">60%</property>
                                      </object>
                                    </child>
                                  </object>
                                </property>
                                <child type="label">
                                  <object class="GtkLabel" id="label22">
                                    <property name="label" translatable="1">&lt;b&gt;CPU usage&lt;/b&gt;</property>
                                    <property name="use-markup">1</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkFrame" id="frame4">
                                <property name="vexpand">1</property>
                                <property name="child">
                                  <object class="GtkBox" id="box3">
                                    <property name="margin-start">12</property>
                                    <property name="orientation">vertical</property>
                                    <property name="spacing">3</property>
                                    <child>
                                      <object class="GtkBox" id="performance-memory-align">
                                        <property name="height-request">75</property>
                                        <child>
                                          <placeholder/>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel" id="performance-memory">
                                        <property name="halign">end</property>
                                        <property name="label">1.59 GiB of 2.2 GiB</property>
                                      </object>
                                    </child>
                                  </object>
                                </property>
                                <child type="label">
                                  <object class="GtkLabel" id="label1">
                                    <property name="label" translatable="1">&lt;b&gt;Memory usage&lt;/b&gt;</property>
                                    <property name="use-markup">1</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      <property name="margin-start">6</property><property name="margin-end">6</property><property name="margin-top">6</property><property name="margin-bottom">6</property></object>
                    </child>
                  </object>
                </property>
                <property name="tab">
                  <object class="GtkLabel" id="label2">
                    <property name="label" translatable="1">_Overview</property>
                    <property name="use-underline">1</property>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkNotebookPage">
                <property name="position">1</property>
                <property name="child">
                  <object class="GtkBox" id="net-align">
                    <child>
                      <placeholder/>
                    </child>
                  </object>
                </property>
                <property name="tab">
                  <object class="GtkLabel" id="label12">
                    <property name="label" translatable="1">_Virtual Networks</property>
                    <property name="use-underline">1</property>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkNotebookPage">
                <property name="position">2</property>
                <property name="child">
                  <object class="GtkBox" id="storage-align">
                    <child>
                      <placeholder/>
                    </child>
                  </object>
                </property>
                <property name="tab">
                  <object class="GtkLabel" id="label13">
                    <property name="label" translatable="1">_Storage</property>
                    <property name="use-underline">1</property>
                  </object>
                </property>
              </object>
            </child>
          <property name="margin-start">6</property><property name="margin-end">6</property><property name="margin-top">6</property><property name="margin-bottom">6</property></object>
        </child>
      </object>
    </property>
  </object>
</interface>
