<?xml version='1.0' encoding='UTF-8'?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <object class="GtkWindow" id="snapshot-top-window">
    <property name="width-request">600</property>
    <property name="height-request">400</property>
    <property name="child">
      <object class="GtkBox" id="snapshot-top-box">
        <property name="hexpand">1</property>
        <property name="vexpand">1</property>
        <property name="orientation">vertical</property>
        <property name="spacing">6</property>
        <child>
          <object class="GtkPaned" id="spaned1">
            <property name="shrink-start-child">0</property>
            <property name="resize-start-child">0</property>
            <property name="vexpand">1</property>
            <property name="focusable">1</property>
            <property name="position">200</property>
            <property name="position-set">1</property>
            <property name="start-child">
              <object class="GtkScrolledWindow" id="scrolledwindow7">
                <property name="focusable">1</property>
                <property name="hscrollbar-policy">never</property>
                <property name="child">
                  <object class="GtkTreeView" id="snapshot-list">
                    <property name="focusable">1</property>
                    <property name="headers-visible">0</property>
                    <signal name="row-activated" handler="on_snapshot_list_row_activated" swapped="no"/>
                    <child internal-child="selection">
                      <object class="GtkTreeSelection" id="treeview-selection">
                        <signal name="changed" handler="on_snapshot_list_changed" swapped="no"/>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </property>
            <property name="end-child">
              <object class="GtkNotebook" id="snapshot-notebook">
                <property name="focusable">1</property>
                <property name="margin-start">12</property>
                <property name="show-border">0</property>
                <child>
                  <object class="GtkNotebookPage">
                    <property name="child">
                      <object class="GtkBox" id="sbox3">
                        <property name="orientation">vertical</property>
                        <property name="spacing">12</property>
                        <child>
                          <object class="GtkGrid" id="sgrid1">
                            <property name="row-spacing">6</property>
                            <property name="column-spacing">6</property>
                            <child>
                              <object class="GtkLabel" id="slabel94">
                                <property name="halign">start</property>
                                <property name="valign">start</property>
                                <property name="label" translatable="1">Description:</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">5</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkScrolledWindow" id="scrolledwindow8">
                                <property name="height-request">80</property>
                                <property name="focusable">1</property>
                                <property name="hexpand">1</property>
                                <property name="child">
                                  <object class="GtkTextView" id="snapshot-description">
                                    <property name="focusable">1</property>
                                    <property name="left-margin">2</property>
                                    <property name="right-margin">2</property>
                                  </object>
                                </property>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">5</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="label92">
                                <property name="halign">start</property>
                                <property name="label" translatable="1">VM State:</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">3</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox" id="hbox3">
                                <property name="spacing">3</property>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">3</property>
                                </layout>
                                <child>
                                  <object class="GtkImage" id="snapshot-status-icon">
                                    <property name="icon-name">image-missing</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="snapshot-status-text">
                                    <property name="halign">start</property>
                                    <property name="label">Shut down</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="label93">
                                <property name="halign">start</property>
                                <property name="label" translatable="1">Timestamp:</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">2</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="snapshot-timestamp">
                                <property name="halign">start</property>
                                <property name="label">label</property>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">2</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="snapshot-title">
                                <property name="halign">start</property>
                                <property name="label">&lt;b&gt;snapshot 'foo'&lt;/b&gt;</property>
                                <property name="use-markup">1</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">0</property>
                                  <property name="column-span">2</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="label5">
                                <property name="halign">start</property>
                                <property name="label" translatable="1">Snapshot Mode:</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">4</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="snapshot-mode">
                                <property name="halign">start</property>
                                <property name="label" translatable="1">label</property>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">4</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="label7">
                                <property name="halign">start</property>
                                <property name="valign">start</property>
                                <property name="label" translatable="1">Screenshot:</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">6</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox" id="box5">
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">6</property>
                                </layout>
                                <child>
                                  <object class="GtkImage" id="snapshot-screenshot">
                                    <property name="icon-name">image-missing</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="snapshot-screenshot-label">
                                    <property name="label" translatable="1">No screenshot available</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox" id="snapshot-is-current">
                                <property name="spacing">3</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">1</property>
                                  <property name="column-span">2</property>
                                </layout>
                                <child>
                                  <object class="GtkImage" id="image2">
                                    <property name="icon-name">dialog-information</property>
                                    <property name="pixel-size">32</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="label652">
                                    <property name="halign">start</property>
                                    <property name="label" translatable="1">&lt;small&gt;&lt;i&gt;This was the most recently applied snapshot.&lt;/i&gt;&lt;/small&gt;</property>
                                    <property name="use-markup">1</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </property>
                    <property name="tab">
                      <object class="GtkLabel" id="label89">
                        <property name="label">details</property>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="GtkNotebookPage">
                    <property name="position">1</property>
                    <property name="child">
                      <object class="GtkLabel" id="snapshot-error-label">
                        <property name="label">error label</property>
                      </object>
                    </property>
                    <property name="tab">
                      <object class="GtkLabel" id="label90">
                        <property name="label">empty</property>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="box2">
            <property name="spacing">6</property>
            <child>
              <object class="GtkBox" id="hbox10">
                <property name="hexpand">1</property>
                <child>
                  <object class="GtkButton" id="snapshot-add">
                    <property name="halign">center</property>
                    <property name="focusable">1</property>
                    <property name="receives-default">1</property>
                    <property name="has-tooltip">1</property>
                    <property name="tooltip-markup" translatable="1">Create new snapshot</property>
                    <property name="tooltip-text" translatable="1">Create new snapshot</property>
                    <signal name="clicked" handler="on_snapshot_add_clicked" swapped="no"/>
                    <child>
                      <object class="GtkImage" id="image1">
                        <property name="icon-name">list-add</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="snapshot-start">
                    <property name="halign">center</property>
                    <property name="focusable">1</property>
                    <property name="receives-default">1</property>
                    <property name="tooltip-markup" translatable="1">Run selected snapshot</property>
                    <signal name="clicked" handler="on_snapshot_start_clicked" swapped="no"/>
                    <child>
                      <object class="GtkImage" id="someicon">
                        <property name="icon-name">media-playback-start</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="snapshot-refresh">
                    <property name="focusable">1</property>
                    <property name="receives-default">1</property>
                    <property name="tooltip-markup" translatable="1">Refresh snapshot list</property>
                    <signal name="clicked" handler="on_snapshot_refresh_clicked" swapped="no"/>
                    <child>
                      <object class="GtkImage" id="image5">
                        <property name="icon-name">view-refresh</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="snapshot-delete">
                    <property name="halign">center</property>
                    <property name="focusable">1</property>
                    <property name="receives-default">1</property>
                    <property name="has-tooltip">1</property>
                    <property name="tooltip-markup" translatable="1">Delete selected snapshot</property>
                    <property name="tooltip-text" translatable="1">Delete selected snapshot</property>
                    <signal name="clicked" handler="on_snapshot_delete_clicked" swapped="no"/>
                    <child>
                      <object class="GtkImage" id="image11">
                        <property name="icon-name">edit-delete</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="buttonbox1">
                <property name="visible">True</property>
                <property name="spacing">6</property>
                <child>
                  <object class="GtkButton" id="snapshot-apply">
                    <property name="label" translatable="1">_Apply</property>
                    <property name="focusable">1</property>
                    <property name="receives-default">1</property>
                    <property name="has-tooltip">1</property>
                    <property name="tooltip-markup" translatable="1">Save updated snapshot metadata</property>
                    <property name="tooltip-text" translatable="1">Save updated snapshot metadata</property>
                    <property name="use-underline">1</property>
                    <signal name="clicked" handler="on_snapshot_apply_clicked" swapped="no"/>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <property name="margin-start">12</property>
        <property name="margin-end">12</property>
        <property name="margin-top">12</property>
        <property name="margin-bottom">12</property>
      </object>
    </property>
  </object>
</interface>
