<?xml version='1.0' encoding='UTF-8'?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <object class="GtkNotebook" id="console-pages">
    <property name="focusable">1</property>
    <property name="hexpand">1</property>
    <property name="show-border">0</property>
    <signal name="switch-page" handler="on_console_pages_switch_page" after="yes" swapped="no"/>
    <child>
      <object class="GtkNotebookPage">
        <property name="tab-expand">True</property>
        <property name="child">
          <object class="GtkLabel" id="console-unavailable">
            <property name="halign">center</property>
            <property name="valign">center</property>
            <property name="label" translatable="1">&lt;b&gt;The console is currently unavailable&lt;/b&gt;</property>
            <property name="use-markup">1</property>
            <property name="justify">center</property>
            <property name="wrap">1</property>
            <property name="selectable">1</property>
            <property name="width-chars">60</property>
            <property name="max-width-chars">60</property>
          </object>
        </property>
        <property name="tab">
          <object class="GtkLabel" id="label434">
            <property name="label">Unavailable</property>
          </object>
        </property>
      </object>
    </child>
    <child>
      <object class="GtkNotebookPage">
        <property name="position">1</property>
        <property name="child">
          <object class="GtkNotebook" id="serial-pages">
            <property name="focusable">1</property>
          </object>
        </property>
        <property name="tab">
          <object class="GtkLabel" id="label82">
            <property name="label" translatable="1">Serial</property>
          </object>
        </property>
      </object>
    </child>
    <child>
      <object class="GtkNotebookPage">
        <property name="position">2</property>
        <property name="child">
          <object class="GtkNotebook" id="console-gfx-pages">
            <property name="focusable">1</property>
            <property name="show-border">0</property>
            <child>
              <object class="GtkNotebookPage">
                <property name="child">
                  <object class="GtkOverlay" id="console-overlay">
                    <property name="child">
                      <object class="GtkScrolledWindow" id="console-gfx-scroll">
                        <property name="focusable">1</property>
                        <property name="child">
                          <object class="GtkViewport" id="console-gfx-viewport">
                            <child>
                              <placeholder/>
                            </child>
                          </object>
                        </property>
                      </object>
                    </property>
                  </object>
                </property>
                <property name="tab">
                  <object class="GtkLabel">
                    <property name="label">Display</property>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkNotebookPage">
                <property name="position">1</property>
                <property name="child">
                  <object class="GtkGrid" id="console-auth">
                    <property name="halign">center</property>
                    <property name="hexpand">1</property>
                    <property name="row-spacing">6</property>
                    <property name="column-spacing">6</property>
                    <child>
                      <object class="GtkLabel" id="label-auth-password">
                        <property name="halign">start</property>
                        <property name="label" translatable="1">_Password:</property>
                        <property name="use-underline">1</property>
                        <property name="mnemonic-widget">console-auth-password</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">1</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="label-auth-username">
                        <property name="halign">start</property>
                        <property name="label" translatable="1">_Username:</property>
                        <property name="use-underline">1</property>
                        <property name="mnemonic-widget">console-auth-username</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">0</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="console-auth-username">
                        <property name="focusable">1</property>
                        <property name="hexpand">1</property>
                        <signal name="activate" handler="on_console_auth_password_activate" swapped="no"/>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">0</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="console-auth-password">
                        <property name="focusable">1</property>
                        <property name="visibility">0</property>
                        <signal name="activate" handler="on_console_auth_password_activate" swapped="no"/>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">1</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="console-auth-login">
                        <property name="label" translatable="1">_Login</property>
                        <property name="focusable">1</property>
                        <property name="use-underline">1</property>
                        <signal name="clicked" handler="on_console_auth_login_clicked" swapped="no"/>
                        <layout>
                          <property name="column">2</property>
                          <property name="row">1</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkCheckButton" id="console-auth-remember">
                        <property name="label" translatable="1">_Save this password in your keyring</property>
                        <property name="focusable">1</property>
                        <property name="tooltip-text" translatable="1">Check to save password, uncheck to forget password.</property>
                        <property name="halign">start</property>
                        <property name="use-underline">1</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">2</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <placeholder/>
                    </child>
                    <child>
                      <placeholder/>
                    </child>
                    <child>
                      <placeholder/>
                    </child>
                    <property name="margin-start">6</property>
                    <property name="margin-end">6</property>
                    <property name="margin-top">6</property>
                    <property name="margin-bottom">6</property>
                  </object>
                </property>
                <property name="tab">
                  <object class="GtkLabel">
                    <property name="label">Auth</property>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkNotebookPage">
                <property name="position">2</property>
                <property name="child">
                  <object class="GtkLabel" id="console-gfx-unavailable">
                    <property name="halign">center</property>
                    <property name="valign">center</property>
                    <property name="label" translatable="1">&lt;b&gt;The console is currently unavailable&lt;/b&gt;</property>
                    <property name="use-markup">1</property>
                    <property name="justify">center</property>
                    <property name="wrap">1</property>
                    <property name="selectable">1</property>
                    <property name="width-chars">60</property>
                    <property name="max-width-chars">60</property>
                  </object>
                </property>
                <property name="tab">
                  <object class="GtkLabel">
                    <property name="label">Unavailable</property>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </property>
        <property name="tab">
          <object class="GtkLabel" id="label439">
            <property name="label">Graphics</property>
          </object>
        </property>
      </object>
    </child>
    <child>
      <object class="GtkNotebookPage">
        <property name="position">3</property>
        <property name="child">
          <object class="GtkButton" id="console-connect-button">
            <property name="label" translatable="1">_Connect to console</property>
            <property name="focusable">1</property>
            <property name="receives-default">1</property>
            <property name="halign">center</property>
            <property name="valign">center</property>
            <property name="use-underline">1</property>
            <signal name="clicked" handler="on_console_connect_button_clicked" swapped="no"/>
          </object>
        </property>
        <property name="tab">
          <object class="GtkLabel">
            <property name="label" translatable="1">Connect</property>
          </object>
        </property>
      </object>
    </child>
  </object>
</interface>
