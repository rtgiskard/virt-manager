                                          <property name="row">6</property>
                                        </layout>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkEntry" id="create-vm-name">
                                        <property name="focusable">1</property>
                                        <property name="halign">start</property>
                                        <property name="width-chars">40</property>
                                        <signal name="changed" handler="on_create_vm_name_changed" swapped="no"/>
                                        <layout>
                                          <property name="column">1</property>
                                          <property name="row">0</property>
                                        </layout>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel" id="label42">
                                        <property name="halign">end</property>
                                        <property name="hexpand">0</property>
                                        <property name="label" translatable="1">_Name:</property>
                                        <property name="use-markup">1</property>
                                        <property name="use-underline">1</property>
                                        <property name="mnemonic-widget">create-vm-name</property>
                                        <style>
                                          <class name="vmm-lighter"/>
                                        </style>
                                        <layout>
                                          <property name="column">0</property>
                                          <property name="row">0</property>
                                        </layout>
                                      </object>
                                    </child>
                                    <child>
