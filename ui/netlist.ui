<?xml version='1.0' encoding='UTF-8'?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <object class="GtkGrid" id="net-source-box">
    <property name="row-spacing">6</property>
    <property name="column-spacing">6</property>
    <child>
      <object class="GtkLabel" id="label1">
        <property name="halign">start</property>
        <property name="hexpand">0</property>
        <property name="label" translatable="1">De_vice name:</property>
        <property name="use-underline">1</property>
        <property name="mnemonic-widget">net-manual-source</property>
        <layout>
          <property name="column">0</property>
          <property name="row">2</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="GtkEntry" id="net-manual-source">
        <property name="focusable">1</property>
        <property name="halign">start</property>
        <property name="hexpand">1</property>
        <signal name="changed" handler="on_net_bridge_name_changed" swapped="no"/>
        <layout>
          <property name="column">1</property>
          <property name="row">2</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="GtkBox" id="net-macvtap-warn-box">
        <property name="halign">start</property>
        <property name="hexpand">0</property>
        <property name="spacing">6</property>
        <layout>
          <property name="column">0</property>
          <property name="row">4</property>
          <property name="column-span">2</property>
        </layout>
        <child>
          <object class="GtkImage" id="image2">
            <property name="icon-name">dialog-warning</property>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="label19">
            <property name="halign">start</property>
            <property name="label" translatable="1">&lt;small&gt;In most configurations, macvtap does not work for host to guest network communication.&lt;/small&gt;</property>
            <property name="use-markup">1</property>
            <property name="wrap">1</property>
            <property name="max-width-chars">35</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkComboBox" id="net-source">
        <property name="halign">start</property>
        <property name="hexpand">0</property>
        <signal name="changed" handler="on_net_source_changed" swapped="no"/>
        <layout>
          <property name="column">0</property>
          <property name="row">1</property>
          <property name="column-span">2</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="GtkBox" id="net-default-warn-box">
        <property name="spacing">6</property>
        <layout>
          <property name="column">0</property>
          <property name="row">0</property>
          <property name="column-span">2</property>
        </layout>
        <child>
          <object class="GtkImage" id="image1">
            <property name="icon-name">dialog-warning</property>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="label2">
            <property name="halign">start</property>
            <property name="label" translatable="1">&lt;small&gt;Failed to find a suitable default network.&lt;/small&gt;</property>
            <property name="use-markup">1</property>
            <property name="wrap">1</property>
            <property name="max-width-chars">35</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkLabel" id="label3">
        <property name="halign">start</property>
        <property name="hexpand">0</property>
        <property name="label" translatable="1">_Portgroup:</property>
        <property name="use-underline">1</property>
        <property name="mnemonic-widget">net-portgroup</property>
        <layout>
          <property name="column">0</property>
          <property name="row">3</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="GtkComboBox" id="net-portgroup">
        <property name="halign">start</property>
        <property name="hexpand">1</property>
        <property name="has-entry">1</property>
        <signal name="changed" handler="on_net_portgroup_changed" swapped="no"/>
        <property name="child">
          <object class="GtkEntry" id="combobox-entry2">
            <property name="focusable">1</property>
          </object>
        </property>
        <layout>
          <property name="column">1</property>
          <property name="row">3</property>
        </layout>
      </object>
    </child>
  </object>
  <object class="GtkLabel" id="net-source-label">
    <property name="halign">end</property>
    <property name="valign">start</property>
    <property name="margin-top">3</property>
    <property name="margin-bottom">3</property>
    <property name="label" translatable="1">_Network source:</property>
    <property name="use-underline">1</property>
    <property name="mnemonic-widget">net-source</property>
  </object>
</interface>
