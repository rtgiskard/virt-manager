<?xml version='1.0' encoding='UTF-8'?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <object class="GtkWindow" id="vmm-create-pool">
    <property name="default-width">400</property>
    <property name="default-height">400</property>
    <property name="title" translatable="1">Add a New Storage Pool</property>
    <signal name="close-request" handler="on_vmm_create_pool_delete_event" swapped="no"/>
    <property name="child">
      <object class="GtkBox" id="vbox1">
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkViewport" id="header">
            <property name="valign">center</property>
            <property name="child">
              <object class="GtkBox" id="hbox77">
                <property name="spacing">10</property>
                <child>
                  <object class="GtkImage" id="image2">
                    <property name="halign">center</property>
                    <property name="icon-name">document-new</property>
                    <property name="pixel-size">48</property>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="hbox2">
                    <property name="hexpand">1</property>
                    <child>
                      <object class="GtkLabel" id="label2">
                        <property name="halign">start</property>
                        <property name="label" translatable="1">&lt;span size='large'&gt;Create storage pool&lt;/span&gt;</property>
                        <property name="use-markup">1</property>
                        <style>
                          <class name="vmm-header-text"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
              <property name="margin-start">6</property><property name="margin-end">6</property><property name="margin-top">6</property><property name="margin-bottom">6</property></object>
            </property>
            <style>
              <class name="vmm-header"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="vbox2">
            <property name="vexpand">1</property>
            <property name="orientation">vertical</property>
            <property name="spacing">18</property>
            <child>
              <object class="GtkBox" id="pool-details-align">
                <child>
                  <object class="GtkGrid" id="pool-details">
                    <property name="valign">start</property>
                    <property name="row-spacing">4</property>
                    <property name="column-spacing">6</property>
                    <child>
                      <object class="GtkBox" id="pool-iqn-box">
                        <property name="spacing">6</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">8</property>
                        </layout>
                        <child>
                          <object class="GtkCheckButton" id="pool-iqn-chk">
                            <property name="focusable">1</property>
                            <property name="halign">start</property>
                            <signal name="toggled" handler="on_pool_iqn_chk_toggled" swapped="no"/>
                          </object>
                        </child>
                        <child>
                          <object class="GtkEntry" id="pool-iqn">
                            <property name="hexpand">1</property>
                            <property name="focusable">1</property>
                            <property name="invisible-char">●</property>
                            <property name="width-chars">25</property>
                            </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="pool-target-label">
                        <property name="halign">end</property>
                        <property name="label" translatable="1">Tar_get Path:</property>
                        <property name="use-underline">1</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">3</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="pool-format-label">
                        <property name="halign">end</property>
                        <property name="label" translatable="1">F_ormat:</property>
                        <property name="use-underline">1</property>
                        <property name="mnemonic-widget">pool-format</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">4</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="pool-hostname-label">
                        <property name="halign">end</property>
                        <property name="label" translatable="1">Host Na_me:</property>
                        <property name="use-underline">1</property>
                        <property name="mnemonic-widget">pool-hostname</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">5</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="pool-source-label">
                        <property name="halign">end</property>
                        <property name="label">_Sourcep:</property>
                        <property name="use-underline">1</property>
                        <property name="mnemonic-widget">pool-source-path</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">7</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="pool-iqn-label">
                        <property name="halign">end</property>
                        <property name="label" translatable="1">Initiator _IQN:</property>
                        <property name="use-underline">1</property>
                        <property name="mnemonic-widget">pool-iqn-chk</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">8</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="pool-target-button">
                        <property name="label" translatable="1">B_rowse</property>
                        <property name="focusable">1</property>
                        <property name="receives-default">1</property>
                        <property name="halign">start</property>
                        <property name="use-underline">1</property>
                        <signal name="clicked" handler="on_pool_target_button_clicked" swapped="no"/>
                        <layout>
                          <property name="column">2</property>
                          <property name="row">3</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="pool-source-button">
                        <property name="label" translatable="1">Bro_wse</property>
                        <property name="focusable">1</property>
                        <property name="receives-default">1</property>
                        <property name="halign">start</property>
                        <property name="use-underline">1</property>
                        <signal name="clicked" handler="on_pool_source_button_clicked" swapped="no"/>
                        <layout>
                          <property name="column">2</property>
                          <property name="row">7</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkComboBox" id="pool-source-path">
                        <property name="has-entry">1</property>
                        <child internal-child="entry">
                          <object class="GtkEntry">
                            <property name="focusable">1</property>
                            <property name="width-chars">25</property>
                            </object>
                        </child>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">7</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="pool-hostname">
                        <property name="focusable">1</property>
                        <property name="invisible-char">●</property>
                        <property name="width-chars">25</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">5</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="pool-source-name-label">
                        <property name="halign">end</property>
                        <property name="label">sourcen_a:</property>
                        <property name="use-underline">1</property>
                        <property name="mnemonic-widget">pool-source-name</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">6</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkComboBox" id="pool-format">
                        <property name="halign">start</property>
                        <property name="has-entry">1</property>
                        <child internal-child="entry">
                          <object class="GtkEntry">
                            <property name="focusable">1</property>
                            <property name="width-chars">10</property>
                          </object>
                        </child>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">4</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="label9">
                        <property name="halign">end</property>
                        <property name="label" translatable="1">_Name:</property>
                        <property name="use-underline">1</property>
                        <property name="mnemonic-widget">pool-name</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">0</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="pool-name">
                        <property name="focusable">1</property>
                        <property name="invisible-char">●</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">0</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="halign">end</property>
                        <property name="label" translatable="1">_Type:</property>
                        <property name="use-underline">1</property>
                        <property name="mnemonic-widget">pool-type</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">1</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkComboBox" id="pool-type">
                        <property name="name">pool-type</property>
                        <signal name="changed" handler="on_pool_type_changed" swapped="no"/>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">1</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkSeparator">
                        <property name="halign">center</property>
                        <property name="valign">start</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">2</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label"> </property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">2</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="pool-target-path">
                        <property name="focusable">1</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">3</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkComboBoxText" id="pool-source-name">
                        <property name="has-entry">1</property>
                        <child internal-child="entry">
                          <object class="GtkEntry" id="pool-source-name-text">
                            <property name="focusable">1</property>
                            </object>
                        </child>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">6</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <placeholder/>
                    </child>
                    <child>
                      <placeholder/>
                    </child>
                    <child>
                      <placeholder/>
                    </child>
                    <child>
                      <placeholder/>
                    </child>
                    <child>
                      <placeholder/>
                    </child>
                    <child>
                      <placeholder/>
                    </child>
                    <child>
                      <placeholder/>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="hbuttonbox1">
                <property name="visible">True</property>
                <style>
                  <class name="vmm-action-row"/>
                </style>
                <property name="spacing">12</property>
                <child>
                  <object class="GtkButton" id="pool-cancel">
                    <property name="label" translatable="1">_Cancel</property>
                    <property name="focusable">1</property>
                    <property name="receives-default">1</property>
                    <property name="use-underline">1</property>
                    <signal name="clicked" handler="on_pool_cancel_clicked" swapped="no"/>
                  </object>
                  </child>
                <child>
                  <object class="GtkButton" id="pool-finish">
                    <property name="label" translatable="1">_Finish</property>
                    <property name="focusable">1</property>
                    <property name="receives-default">1</property>
                    <property name="use-underline">1</property>
                    <signal name="clicked" handler="on_pool_finish_clicked" swapped="no"/>
                  </object>
                  </child>
              </object>
            </child>
          <property name="margin-start">12</property><property name="margin-end">12</property><property name="margin-top">12</property><property name="margin-bottom">12</property></object>
        </child>
      </object>
    </property>
  </object>
</interface>
